<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.PasswordRecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1440" d:DesignHeight="1024">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="24"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Background"      Value="#F3F3F3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="45"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="Foreground"      Value="Black"/>
            <Setter Property="CaretBrush"      Value="Black"/>
        </Style>
        <Style x:Key="FieldPassword" TargetType="PasswordBox">
            <Setter Property="Background"      Value="#F3F3F3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="45"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="Foreground"      Value="Black"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#BF5B92E5"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="20"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="110"/>
            <Setter Property="Height"          Value="45"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#F0F0F0"/>
            <Setter Property="Foreground"      Value="#121212"/>
            <Setter Property="FontSize"        Value="20"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="110"/>
            <Setter Property="Height"          Value="45"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OutlineBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#5B92E5"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderBrush"     Value="#BF5B92E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="16,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="49*"/>
            <ColumnDefinition Width="51*"/>
        </Grid.ColumnDefinitions>

        <!-- 좌측: 파란 배경 -->
        <Border Grid.Column="0" Background="#BF5B92E5"/>

        <!-- 우측: 폼 -->
        <Grid Grid.Column="1" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Width="342" HorizontalAlignment="Center"
                            Margin="0,60,0,60">

                    <!-- ===== STEP 1: 아이디 입력 ===== -->
                    <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">

                        <TextBlock Text="Find Password"
                                   FontSize="35" Foreground="Black"
                                   Margin="0,0,0,40"/>

                        <TextBlock Text="ID" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldInput}"
                                 Margin="0,0,0,40"/>

                        <TextBlock Text="{Binding Message}"
                                   Foreground="#E53E3E" TextWrapping="Wrap"
                                   FontSize="13" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="Cancel"
                                    Style="{StaticResource SecondaryBtn}"
                                    Command="{Binding CancelCommand}"
                                    Margin="0,0,10,0"/>
                            <Button Grid.Column="2" Content="Confirm"
                                    Style="{StaticResource PrimaryBtn}"
                                    Command="{Binding FindAccountCommand}"/>
                        </Grid>
                    </StackPanel>

                    <!-- ===== STEP 2: 인증 방법 선택 ===== -->
                    <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">

                        <TextBlock Text="Verify Identity"
                                   FontSize="35" Foreground="Black"
                                   Margin="0,0,0,8" Height="60"/>
                        <TextBlock Text="{Binding Username}"
                                   FontSize="16" Foreground="#6C757D"
                                   Margin="0,0,0,32" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform AngleX="6.163"/>
                                    <RotateTransform Angle="0.016"/>
                                    <TranslateTransform X="-1.149"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <!-- 보안 질문 방식 -->
                        <StackPanel Visibility="{Binding IsSecurityQuestionMethodChosen, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding AvailableMethods.SecurityQuestion}"
                                       FontSize="16" Foreground="#121212"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>
                            <TextBlock Text="Answer" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SecurityAnswer, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldInput}"
                                     Margin="0,0,0,16"/>
                            <Button Content="Use Email OTP instead"
                                    Style="{StaticResource OutlineBtn}"
                                    Command="{Binding ChooseEmailCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,32"
                                    Visibility="{Binding AvailableMethods.IsEmailUsable, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Confirm"
                                    Style="{StaticResource PrimaryBtn}"
                                    HorizontalAlignment="Right"
                                    Command="{Binding VerifySecurityAnswerCommand}"/>
                        </StackPanel>

                        <!-- 이메일 OTP 방식 -->
                        <StackPanel Visibility="{Binding IsEmailMethodChosen, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding AvailableMethods.MaskedEmail}"
                                       FontSize="14" Foreground="#6C757D"
                                       Margin="0,0,0,12"/>
                            <Button Content="Send Code"
                                    Style="{StaticResource OutlineBtn}"
                                    Command="{Binding SendOtpCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,20"/>
                            <TextBlock Text="Code" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding OtpCode, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldInput}"
                                     Margin="0,0,0,16"/>
                            <Button Content="Use Security Question instead"
                                    Style="{StaticResource OutlineBtn}"
                                    Command="{Binding ChooseSecurityQuestionCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,32"
                                    Visibility="{Binding AvailableMethods.HasSecurityQuestion, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Confirm"
                                    Style="{StaticResource PrimaryBtn}"
                                    HorizontalAlignment="Right"
                                    Command="{Binding VerifyOtpCommand}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Message}"
                                   Foreground="#E53E3E" TextWrapping="Wrap"
                                   FontSize="13" Margin="0,16,0,0"/>
                    </StackPanel>

                    <!-- ===== STEP 3: 새 비밀번호 설정 ===== -->
                    <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">

                        <TextBlock Text="New Password"
                                   FontSize="40" Foreground="Black"
                                   Margin="0,0,0,40"/>

                        <TextBlock Text="New Password" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="NewPasswordInput"
                                     Style="{StaticResource FieldPassword}"
                                     Margin="0,0,0,28"/>

                        <TextBlock Text="Confirm Password" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="ConfirmNewPasswordInput"
                                     Style="{StaticResource FieldPassword}"
                                     Margin="0,0,0,40"/>

                        <TextBlock Text="{Binding Message}"
                                   Foreground="#E53E3E" TextWrapping="Wrap"
                                   FontSize="13" Margin="0,0,0,16"/>

                        <Button Content="Reset Password"
                                Style="{StaticResource PrimaryBtn}"
                                Width="160"
                                HorizontalAlignment="Right"
                                Click="OnResetPasswordClick"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>