# 게시(publish) 산출물
[Pp]ublish/
*.[Pp]ublish.xml
*.azurePubxml

# 게시 프로필의 사용자별 설정 — 자격 증명이 들어갈 수 있으므로 커밋 금지.
# (FolderProfile.pubxml 본체는 팀 공유 설정이므로 커밋한다)
*.pubxml.user

# Visual Studio 사용자별 파일 / 캐시
.vs/
*.user
*.suo
*.userprefs
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb

# Rider / VS Code
.idea/
*.sln.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# NuGet
*.nupkg
*.snupkg
packages/
!packages/build/
*.nuget.props
*.nuget.targets

# 테스트 / 커버리지 결과
[Tt]est[Rr]esult*/
