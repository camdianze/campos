<Project Sdk="Microsoft.NET.Sdk">

  <!--
    라이선스 코드 발급 도구. 개발자(발급자)만 쓰는 콘솔 프로그램이다.
    고객에게 배포하는 PharmaPOS.exe와는 완전히 별개이며 절대 함께 배포하지 않는다.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PharmaPOS.Tools.LicenseIssuer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PharmaPOS.Application\PharmaPOS.Application.csproj" />
  </ItemGroup>

</Project>
