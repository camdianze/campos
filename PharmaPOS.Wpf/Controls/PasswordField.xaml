<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Controls.PasswordField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 눈 아이콘은 글꼴이 아니라 선으로 그린다. 이모지(👁)나 아이콘 폰트는 PC에
             그 글꼴이 없으면 네모 상자로 나오는데, 버튼이 통째로 뜻을 잃는다. -->
        <Style x:Key="RevealToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width"  Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Hit" Background="Transparent" CornerRadius="6">
                            <Canvas Width="20" Height="14"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="Outline"
                                      Data="M 1,7 C 4,2 16,2 19,7 C 16,12 4,12 1,7 Z"
                                      Stroke="{StaticResource MutedTextBrush}"
                                      StrokeThickness="1.4"
                                      StrokeLineJoin="Round"/>
                                <Ellipse x:Name="Pupil"
                                         Canvas.Left="7.6" Canvas.Top="4.6"
                                         Width="4.8" Height="4.8"
                                         Fill="{StaticResource MutedTextBrush}"/>
                                <!-- 비밀번호가 보이는 상태에서만 사선이 그어진다:
                                     "지금 보이는 중, 누르면 감춘다"는 뜻이다. -->
                                <Line x:Name="Slash"
                                      X1="1.5" Y1="12.5" X2="18.5" Y2="1.5"
                                      Stroke="{StaticResource MutedTextBrush}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Canvas>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Slash"   Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Outline" Property="Stroke" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Pupil"   Property="Fill"   Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Slash"   Property="Stroke" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hit" Property="Background" Value="{StaticResource SubtleSurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 테두리를 이 컨트롤이 직접 그린다. 안쪽 입력칸은 테두리 없이 두고, 눈 버튼을
         그 테두리 <b>안</b>에 넣기 위해서다 — 밖에 두면 칸 옆에 떠 있는 것처럼 보인다.
         색과 모서리, 포커스 반응은 App.xaml의 TextBox/PasswordBox와 같은 값이다. -->
    <Border x:Name="Root" SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background"      Value="{StaticResource FieldBrush}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BorderBrushSoft}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius"    Value="8"/>
                <Setter Property="MinHeight"       Value="40"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="Background"  Value="{StaticResource SurfaceBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Style="{x:Null}"로 App.xaml의 암시적 스타일을 끊는다. 그대로 두면
                 그 템플릿이 자기 테두리와 배경을 이 테두리 안에 한 겹 더 그린다. -->
            <PasswordBox x:Name="Masked" Grid.Column="0"
                         Style="{x:Null}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextBrush}"
                         CaretBrush="{StaticResource TextBrush}"
                         FontSize="14" Padding="12,0"
                         VerticalContentAlignment="Center"/>

            <TextBox x:Name="Revealed" Grid.Column="0"
                     Style="{x:Null}"
                     Visibility="Collapsed"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextBrush}"
                     CaretBrush="{StaticResource TextBrush}"
                     FontSize="14" Padding="12,0"
                     VerticalContentAlignment="Center"/>

            <ToggleButton x:Name="RevealToggle" Grid.Column="1"
                          Style="{StaticResource RevealToggleStyle}"
                          ToolTip="Show password"
                          Checked="OnRevealChanged"
                          Unchecked="OnRevealChanged"/>
        </Grid>
    </Border>
</UserControl>
