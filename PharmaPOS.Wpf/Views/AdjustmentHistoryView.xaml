<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.AdjustmentHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="White"
             d:DesignWidth="900" d:DesignHeight="600">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Adjustment History"
                   Style="{StaticResource PageTitle}"
                   Margin="0,0,0,20"/>

        <!-- 필터 바 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DatePicker Grid.Column="0"
                        SelectedDate="{Binding DateFrom}"
                        Height="36" Margin="0,0,8,0"/>

            <DatePicker Grid.Column="1"
                        SelectedDate="{Binding DateTo}"
                        Height="36" Margin="0,0,8,0"/>

            <TextBox Grid.Column="2"
                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     Height="36" FontSize="13"
                     Margin="0,0,8,0"/>

            <Button Grid.Column="3" Content="Search"
                    Style="{StaticResource PrimaryBtn}" Height="36"
                    Command="{Binding SearchCommand}"
                    Margin="0,0,8,0"/>

            <Button Grid.Column="4" Content="Reset"
                    Style="{StaticResource SecondaryBtn}" Height="36"
                    Command="{Binding ResetCommand}"/>
        </Grid>

        <!-- 데이터 그리드 -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Records}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  BorderThickness="1"
                  BorderBrush="{StaticResource BorderBrushSoft}"
                  RowBackground="White"
                  AlternatingRowBackground="{StaticResource SubtleSurfaceBrush}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource BorderBrushSoft}"
                  RowHeight="36">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date"        Binding="{Binding AdjustedAt}"  Width="150"/>
                <DataGridTextColumn Header="Product"     Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Batch"       Binding="{Binding BatchNumber}" Width="120"/>
                <DataGridTextColumn Header="Qty Change"  Binding="{Binding Quantity}"    Width="90"/>
                <DataGridTextColumn Header="Reason"      Binding="{Binding Reason}"      Width="160"/>
                <DataGridTextColumn Header="Adjusted By" Binding="{Binding AdjustedBy}"  Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 하단 버튼 -->
        <Button Grid.Row="3"
                Content="← Back"
                Style="{StaticResource SecondaryBtn}"
                HorizontalAlignment="Left"
                Margin="0,14,0,0"
                Command="{Binding BackCommand}"/>

        <TextBlock Grid.Row="4"
                   Text="{Binding Message}"
                   Style="{StaticResource ErrorText}"
                   MinHeight="18" Margin="0,8,0,0"/>
    </Grid>
</UserControl>