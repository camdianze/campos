<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.AdjustmentHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="White"
             d:DesignWidth="900" d:DesignHeight="600">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Adjustment History"
                   FontSize="28" FontWeight="Light"
                   Foreground="#121212" Margin="0,0,0,20"/>

        <!-- 필터 바 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DatePicker Grid.Column="0"
                        SelectedDate="{Binding DateFrom}"
                        Height="36" Margin="0,0,8,0"/>

            <DatePicker Grid.Column="1"
                        SelectedDate="{Binding DateTo}"
                        Height="36" Margin="0,0,8,0"/>

            <TextBox Grid.Column="2"
                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     Background="#F3F3F3" BorderThickness="0"
                     Padding="10,8" FontSize="13" Height="36"
                     VerticalContentAlignment="Center"
                     Margin="0,0,8,0"/>

            <Button Grid.Column="3" Content="Search"
                    Height="36" Padding="16,0"
                    Background="#BF5B92E5" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Command="{Binding SearchCommand}"
                    Margin="0,0,8,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Grid.Column="4" Content="Reset"
                    Height="36" Padding="16,0"
                    Background="#F0F0F0" Foreground="#121212"
                    BorderThickness="0" Cursor="Hand"
                    Command="{Binding ResetCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 데이터 그리드 -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Records}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  BorderThickness="1"
                  BorderBrush="#E0E0E0"
                  RowBackground="White"
                  AlternatingRowBackground="#F8F9FA"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E0E0E0"
                  RowHeight="36">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"   Value="#F1F3F5"/>
                    <Setter Property="Foreground"   Value="#6C757D"/>
                    <Setter Property="FontSize"     Value="12"/>
                    <Setter Property="FontWeight"   Value="SemiBold"/>
                    <Setter Property="Padding"      Value="10,0"/>
                    <Setter Property="Height"       Value="38"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush"  Value="#E0E0E0"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date"        Binding="{Binding AdjustedAt}"  Width="150"/>
                <DataGridTextColumn Header="Product"     Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Batch"       Binding="{Binding BatchNumber}" Width="120"/>
                <DataGridTextColumn Header="Qty Change"  Binding="{Binding Quantity}"    Width="90"/>
                <DataGridTextColumn Header="Reason"      Binding="{Binding Reason}"      Width="160"/>
                <DataGridTextColumn Header="Adjusted By" Binding="{Binding AdjustedBy}"  Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 하단 버튼 -->
        <Button Grid.Row="3"
                Content="← Back"
                HorizontalAlignment="Left"
                Height="36" Padding="16,0"
                Background="#F0F0F0" Foreground="#121212"
                BorderThickness="0" Cursor="Hand"
                Margin="0,14,0,0"
                Command="{Binding BackCommand}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <TextBlock Grid.Row="4"
                   Text="{Binding Message}"
                   Foreground="#E53E3E"
                   TextWrapping="Wrap" FontSize="13"
                   Margin="0,8,0,0"/>
    </Grid>
</UserControl>