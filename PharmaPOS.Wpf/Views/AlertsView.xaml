<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svc="clr-namespace:Lightweight_Digital_Inventory_Management___POS_System.Services"
             mc:Ignorable="d"
             Background="White"
             d:DesignWidth="750" d:DesignHeight="500">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{svc:Loc ui.alert.screen_title, Inventory Alerts}"
                   Style="{StaticResource PageTitle}"
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding AvailableTypeFilters}"
                      SelectedItem="{Binding SelectedTypeFilter}"
                      Height="36" Margin="0,0,8,0"/>

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding AvailablePriorityFilters}"
                      SelectedItem="{Binding SelectedPriorityFilter}"
                      Height="36"/>
        </Grid>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Alerts}"
                  SelectedItem="{Binding SelectedAlert}"
                  PreviewMouseRightButtonDown="OnGridRightButtonDown"
                  ContextMenuOpening="OnGridContextMenuOpening"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  BorderThickness="1"
                  BorderBrush="{StaticResource BorderBrushSoft}"
                  RowBackground="White"
                  AlternatingRowBackground="{StaticResource SubtleSurfaceBrush}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource BorderBrushSoft}"
                  RowHeight="36">
            <!-- 우클릭 메뉴. 알림을 보고 나서 할 일은 둘 중 하나다 —
                 그 약의 재고를 보러 가거나, 상품 정보를 고치러 가거나. -->
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{svc:Loc ui.alert.go_inventory, Go to Inventory}"
                              Command="{Binding ViewInventoryCommand}"
                              IsEnabled="{Binding HasSelection}"/>
                    <MenuItem Header="{svc:Loc ui.alert.go_product, Go to Product}"
                              Command="{Binding ViewProductCommand}"
                              IsEnabled="{Binding HasSelection}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTextColumn Header="{svc:Loc ui.alert.col.type, Type}"         Binding="{Binding AlertType, Converter={StaticResource LocalizedEnum}, ConverterParameter=ui.alert.type}"   Width="100"/>
                <DataGridTextColumn Header="{svc:Loc ui.alert.col.priority, Priority}"     Binding="{Binding Priority, Converter={StaticResource LocalizedEnum}, ConverterParameter=ui.alert.priority}"    Width="100"/>
                <DataGridTextColumn Header="{svc:Loc ui.alert.col.product, Product Name}" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="{svc:Loc ui.alert.col.quantity, Quantity}"     Binding="{Binding Quantity}"    Width="90"/>
                <DataGridTextColumn Header="Batch Number" Binding="{Binding BatchNumber}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="{svc:Loc ui.common.back, ← Back}"         Style="{StaticResource SecondaryBtn}" Click="OnBackClick"                     Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="{svc:Loc ui.alert.view_inventory, View Inventory}"  Style="{StaticResource SecondaryBtn}" Command="{Binding ViewInventoryCommand}" Margin="0,0,8,0"/>
            <Button Grid.Column="3" Content="{svc:Loc ui.common.export, Export}"          Style="{StaticResource PrimaryBtn}"   Command="{Binding ExportCommand}"/>
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="{Binding Message}"
                   Style="{StaticResource ErrorText}"
                   MinHeight="18" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
