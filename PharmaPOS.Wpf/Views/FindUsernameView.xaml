<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.FindUsernameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1440" d:DesignHeight="1024">

    <!-- 스타일은 App.xaml 공통 테마에서 온다. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="49*"/>
            <ColumnDefinition Width="51*"/>
        </Grid.ColumnDefinitions>

        <!-- 좌측: 파란 배경 -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}"/>

        <!-- 우측: 폼 -->
        <Grid Grid.Column="1" Background="White">
            <StackPanel Width="342" HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock Text="Find ID"
                           Style="{StaticResource PageTitle}" FontSize="28"
                           Margin="0,0,0,28"/>

                <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding RecoveryEmail, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,24"/>

                <TextBlock Text="{Binding Message}"
                           Style="{StaticResource Caption}"
                           Foreground="{StaticResource PrimaryBrush}"
                           Margin="0,0,0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="Cancel"
                            Style="{StaticResource SecondaryBtnLarge}"
                            Command="{Binding CancelCommand}"
                            Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="Confirm"
                            Style="{StaticResource PrimaryBtnLarge}"
                            Command="{Binding FindUsernameCommand}"/>
                </Grid>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>