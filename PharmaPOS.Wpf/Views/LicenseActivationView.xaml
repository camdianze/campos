<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.LicenseActivationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="560">

    <!-- 좌측 파란 패널 + 우측 폼 구성은 InitialSetupView, FindUsernameView와 같다.
         색과 크기는 App.xaml 공통 테마에서 온다. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="49*"/>
            <ColumnDefinition Width="51*"/>
        </Grid.ColumnDefinitions>

        <ContentControl Grid.Column="0" Style="{StaticResource BrandPanel}"/>

        <Grid Grid.Column="1" Background="White">
            <StackPanel Width="342" HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock Text="Activate CamPOS"
                           Style="{StaticResource PageTitle}" FontSize="28"
                           Margin="0,0,0,6"/>

                <TextBlock Text="Enter the license code that came with your copy. This is a one-time step and works without an internet connection."
                           Style="{StaticResource Caption}"
                           Margin="0,0,0,28"/>

                <TextBlock Text="License Code" Style="{StaticResource FieldLabel}"/>

                <!-- 코드가 124자라 한 줄에 안 들어간다. 여러 줄로 보여주고 줄바꿈은 디코더가 무시한다.
                     현장에서 손으로 치는 건 무리라 아래 파일 불러오기를 함께 둔다. -->
                <TextBox x:Name="LicenseCodeInput"
                         Text="{Binding LicenseCode, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13"
                         Height="88"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         Padding="12,10"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,8"/>

                <Button Content="Load from file…"
                        Style="{StaticResource SecondaryBtn}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,16"
                        Click="OnLoadFromFileClick"/>

                <!-- MinHeight로 자리를 미리 잡아둔다. 없으면 오류가 뜰 때 폼이 밀린다. -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorText}"
                           MinHeight="18" Margin="0,0,0,16"/>

                <!-- IsDefault="True"라 입력 칸에서 Enter를 눌러도 활성화된다. -->
                <Button Content="Activate"
                        Style="{StaticResource PrimaryBtnLarge}"
                        IsDefault="True"
                        HorizontalAlignment="Right"
                        Command="{Binding ActivateCommand}"/>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
