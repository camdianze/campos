<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.RecoverySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="White"
             d:DesignWidth="500" d:DesignHeight="650">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Width="420" Margin="0,24,0,24" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 제목 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Recovery Settings"
                           Style="{StaticResource PageTitle}" Margin="0,0,0,8"/>
                <TextBlock Style="{StaticResource Caption}"
                           Text="Set up at least one recovery method in case you forget your password."/>
            </StackPanel>

            <!-- 보안 질문 -->
            <StackPanel Grid.Row="1" Margin="0,0,0,24">
                <TextBlock Text="SECURITY QUESTION" Style="{StaticResource EyebrowLabel}"/>

                <TextBlock Text="Question" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding AvailableSecurityQuestions}"
                          SelectedItem="{Binding SelectedSecurityQuestion}"
                          Margin="0,0,0,14"/>

                <TextBlock Text="Answer" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding SecurityAnswer, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldInput}"/>
            </StackPanel>

            <!-- 이메일 복구 -->
            <StackPanel Grid.Row="2" Margin="0,0,0,24">
                <TextBlock Text="RECOVERY EMAIL" Style="{StaticResource EyebrowLabel}"/>

                <TextBlock Text="Email Address" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding RecoveryEmail, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldInput}" Margin="0,0,0,14"/>

                <TextBlock Text="Email Provider" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding AvailableEmailProviders}"
                          SelectedItem="{Binding SelectedEmailProvider}"
                          Margin="0,0,0,14"/>

                <TextBlock Text="App Password" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="AppPasswordInput"
                             Style="{StaticResource FieldPassword}"
                             Margin="0,0,0,14"/>

                <StackPanel Visibility="{Binding IsOtherProvider, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="SMTP Host" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInput}" Margin="0,0,0,14"/>

                    <TextBlock Text="SMTP Port" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInput}"/>
                </StackPanel>
            </StackPanel>

            <!-- 버튼 -->
            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="← Back"
                        Style="{StaticResource SecondaryBtn}"
                        Padding="16,0" Margin="0,0,6,0"
                        Command="{Binding BackCommand}"/>
                <Button Grid.Column="1" Content="Save"
                        Style="{StaticResource PrimaryBtn}"
                        Padding="16,0" Margin="6,0,0,0"
                        Click="OnSaveClick"/>
            </Grid>

            <TextBlock Grid.Row="4"
                       Text="{Binding Message}"
                       Style="{StaticResource ErrorText}" MinHeight="18"/>
        </Grid>
    </ScrollViewer>
</UserControl>