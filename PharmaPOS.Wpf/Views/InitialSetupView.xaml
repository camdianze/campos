<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.InitialSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1440" d:DesignHeight="1024">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="22"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Background"      Value="#F3F3F3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="45"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="Foreground"      Value="Black"/>
            <Setter Property="CaretBrush"      Value="Black"/>
        </Style>

        <Style x:Key="FieldPassword" TargetType="PasswordBox">
            <Setter Property="Background"      Value="#F3F3F3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="45"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="Foreground"      Value="Black"/>
        </Style>

        <Style x:Key="NextButton" TargetType="Button">
            <Setter Property="Background"      Value="#BF5B92E5"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="20"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="110"/>
            <Setter Property="Height"          Value="45"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Background"      Value="#F0F0F0"/>
            <Setter Property="Foreground"      Value="#121212"/>
            <Setter Property="FontSize"        Value="20"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="110"/>
            <Setter Property="Height"          Value="45"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="49*"/>
            <ColumnDefinition Width="51*"/>
        </Grid.ColumnDefinitions>

        <!-- 좌측: 파란 배경 -->
        <Border Grid.Column="0" Background="#BF5B92E5"/>

        <!-- 우측: 폼 영역 -->
        <Grid Grid.Column="1" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Width="342" HorizontalAlignment="Center"
                            Margin="0,60,0,60">

                    <!-- ===== STEP 1: 시설 정보 ===== -->
                    <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">

                        <TextBlock Text="Initial Facility Setup"
                                   FontSize="35" Foreground="Black"
                                   Margin="0,0,0,40"/>

                        <TextBlock Text="Facility Name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FacilityName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldInput}" Margin="0,0,0,28"/>

                        <TextBlock Text="Country" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldInput}" Margin="0,0,0,28"/>

                        <TextBlock Text="Province / District" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding District, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldInput}" Margin="0,0,0,28"/>

                        <TextBlock Text="Facility Type" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailableFacilityTypes}"
                                  SelectedItem="{Binding SelectedFacilityType}"
                                  Height="45" FontSize="16"
                                  Margin="0,0,0,40"/>

                        <Button Content="Next"
                                Style="{StaticResource NextButton}"
                                HorizontalAlignment="Right"
                                Command="{Binding NextCommand}"/>
                    </StackPanel>

                    <!-- ===== STEP 2: 관리자 계정 ===== -->
                    <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">

                        <TextBlock Text="Login Setup"
                                   FontSize="35" Foreground="Black"
                                   Margin="0,0,0,40"/>

                        <TextBlock Text="ID*" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding AdminUsername, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldInput}" Margin="0,0,0,28"/>

                        <TextBlock Text="Password*" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="AdminPasswordInput"
                                     Style="{StaticResource FieldPassword}" Margin="0,0,0,4"/>
                        <TextBlock Text="* Min 8 characters, 1 number. No space. Only - '! @ # $ % ^ &amp; *'"
                                   FontSize="11" Foreground="#888888" Margin="0,0,0,24"/>

                        <TextBlock Text="Confirm Password*" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="ConfirmAdminPasswordInput"
                                     Style="{StaticResource FieldPassword}" Margin="0,0,0,28"/>

                        <TextBlock Text="Security Question" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailableSecurityQuestions}"
                                  SelectedItem="{Binding SelectedSecurityQuestion}"
                                  Height="45" FontSize="14" Margin="0,0,0,28"/>

                        <TextBlock Text="Answer" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SecurityAnswerInput"
                                 Style="{StaticResource FieldInput}" Margin="0,0,0,40"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="Back"
                                    Style="{StaticResource BackButton}"
                                    Command="{Binding BackCommand}"
                                    Margin="0,0,10,0"/>
                            <Button Grid.Column="2" Content="Next"
                                    Style="{StaticResource NextButton}"
                                    Click="OnCompleteClick"/>
                        </Grid>
                    </StackPanel>

                    <!-- 메시지 -->
                    <TextBlock Text="{Binding Message}"
                               Foreground="{Binding MessageColor}"
                               TextWrapping="Wrap" FontSize="13"
                               Margin="0,16,0,0"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
