<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.PasswordRecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1440" d:DesignHeight="1024">

    <!-- 스타일은 App.xaml 공통 테마에서 온다. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="49*"/>
            <ColumnDefinition Width="51*"/>
        </Grid.ColumnDefinitions>

        <!-- 좌측: 파란 배경 -->
        <ContentControl Grid.Column="0" Style="{StaticResource BrandPanel}"/>

        <!-- 우측: 폼 -->
        <Grid Grid.Column="1" Background="White">
            <!-- 폼을 세로 가운데에 둔다. ScrollViewer는 자식을 무한 높이로 재기 때문에
                 StackPanel에 VerticalAlignment만 주면 아무 일도 일어나지 않는다(늘 위에 붙는다).
                 그래서 뷰포트 높이만큼의 최소 높이를 가진 Grid를 하나 끼우고 그 안에서 가운데를 잡는다.
                 3단계 폼이 창보다 길어지면 Grid가 그만큼 늘어나 스크롤은 그대로 동작한다. -->
            <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto">
                <Grid MinHeight="{Binding ViewportHeight, ElementName=FormScroll}">
                <StackPanel Width="342" HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,60,0,60">

                    <!-- ===== STEP 1: 아이디 입력 ===== -->
                    <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">

                        <TextBlock Text="Find Password"
                                   Style="{StaticResource PageTitle}" FontSize="28"
                                   Margin="0,0,0,28"/>

                        <TextBlock Text="ID" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,24"/>

                        <TextBlock Text="{Binding Message}"
                                   Style="{StaticResource ErrorText}" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="Cancel"
                                    Style="{StaticResource SecondaryBtnLarge}"
                                    Command="{Binding CancelCommand}"
                                    Margin="0,0,10,0"/>
                            <Button Grid.Column="2" Content="Confirm"
                                    Style="{StaticResource PrimaryBtnLarge}"
                                    Command="{Binding FindAccountCommand}"/>
                        </Grid>
                    </StackPanel>

                    <!-- ===== STEP 2: 인증 방법 선택 ===== -->
                    <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">

                        <!-- 아이디 표시에 걸려 있던 SkewTransform(기울임)은 Blend에서 딸려온
                             흔적이라 제거했다. 다른 화면과 글자 기울기가 달라 보였다. -->
                        <TextBlock Text="Verify Identity"
                                   Style="{StaticResource PageTitle}" FontSize="28"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Username}"
                                   Style="{StaticResource Caption}" FontSize="15"
                                   Margin="0,0,0,28"/>

                        <!-- 보안 질문 방식 -->
                        <StackPanel Visibility="{Binding IsSecurityQuestionMethodChosen, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding AvailableMethods.SecurityQuestion}"
                                       Style="{StaticResource SectionLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>
                            <TextBlock Text="Answer" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SecurityAnswer, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,16"/>
                            <Button Content="Use Email OTP instead"
                                    Style="{StaticResource OutlineBtn}"
                                    Command="{Binding ChooseEmailCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,32"
                                    Visibility="{Binding AvailableMethods.IsEmailUsable, Converter={StaticResource BoolToVis}}"/>

                            <!-- 버튼 줄은 1단계(Cancel/Confirm)와 같은 3칸 배치를 쓴다. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1" Content="Back"
                                        Style="{StaticResource SecondaryBtnLarge}"
                                        Command="{Binding BackCommand}"
                                        Margin="0,0,10,0"/>
                                <Button Grid.Column="2" Content="Confirm"
                                        Style="{StaticResource PrimaryBtnLarge}"
                                        Command="{Binding VerifySecurityAnswerCommand}"/>
                            </Grid>
                        </StackPanel>

                        <!-- 이메일 OTP 방식 -->
                        <StackPanel Visibility="{Binding IsEmailMethodChosen, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding AvailableMethods.MaskedEmail}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,0,0,12"/>
                            <Button Content="Send Code"
                                    Style="{StaticResource OutlineBtn}"
                                    Command="{Binding SendOtpCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,20"/>
                            <TextBlock Text="Code" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding OtpCode, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,16"/>
                            <Button Content="Use Security Question instead"
                                    Style="{StaticResource OutlineBtn}"
                                    Command="{Binding ChooseSecurityQuestionCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,32"
                                    Visibility="{Binding AvailableMethods.HasSecurityQuestion, Converter={StaticResource BoolToVis}}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1" Content="Back"
                                        Style="{StaticResource SecondaryBtnLarge}"
                                        Command="{Binding BackCommand}"
                                        Margin="0,0,10,0"/>
                                <Button Grid.Column="2" Content="Confirm"
                                        Style="{StaticResource PrimaryBtnLarge}"
                                        Command="{Binding VerifyOtpCommand}"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="{Binding Message}"
                                   Style="{StaticResource ErrorText}" Margin="0,16,0,0"/>
                    </StackPanel>

                    <!-- ===== STEP 3: 새 비밀번호 설정 ===== -->
                    <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">

                        <TextBlock Text="New Password"
                                   Style="{StaticResource PageTitle}" FontSize="28"
                                   Margin="0,0,0,28"/>

                        <TextBlock Text="New Password" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="NewPasswordInput" Margin="0,0,0,18"/>

                        <TextBlock Text="Confirm Password" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="ConfirmNewPasswordInput" Margin="0,0,0,24"/>

                        <TextBlock Text="{Binding Message}"
                                   Style="{StaticResource ErrorText}" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="Back"
                                    Style="{StaticResource SecondaryBtnLarge}"
                                    Command="{Binding BackCommand}"
                                    Margin="0,0,10,0"/>
                            <Button Grid.Column="2" Content="Reset Password"
                                    Style="{StaticResource PrimaryBtnLarge}"
                                    Click="OnResetPasswordClick"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>