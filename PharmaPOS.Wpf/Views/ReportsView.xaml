<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Lightweight_Digital_Inventory_Management___POS_System.Converters"
             mc:Ignorable="d"
             Background="White"
             d:DesignWidth="1000" d:DesignHeight="700">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:ChangeDirectionToBrushConverter x:Key="ChangeBrush"/>
        <converters:AwareGroupToBrushConverter x:Key="AwareBrush"/>
        <converters:FractionToStarConverter x:Key="FractionStar"/>

        <!-- 표 안의 증감 칸. 방향에 따라 글자색이 갈린다. 컬럼마다 바인딩 경로가 달라
             ElementStyle을 공유할 수 없어서, 색만 각 컬럼에서 지정한다. -->
        <Style x:Key="ChangeCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- 요약 카드. 관리자 대시보드의 지표 카드와 같은 모양을 쓴다. -->
        <Style x:Key="SummaryCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin"  Value="0,0,10,0"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="SummaryLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin"   Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="SummaryChange" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin"     Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 제목 -->
            <RowDefinition Height="Auto"/>   <!-- 기간 선택 -->
            <RowDefinition Height="Auto"/>   <!-- 프리셋 -->
            <RowDefinition Height="Auto"/>   <!-- 요약 카드 -->
            <RowDefinition Height="*"/>      <!-- 좌: 상품 순위 / 우: 항생제 -->
            <RowDefinition Height="Auto"/>   <!-- 좌: 매출 추이 / 우: 항생제 추이 -->
            <RowDefinition Height="Auto"/>   <!-- 하단 버튼 -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reports" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>

        <!-- 기간 선택 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DatePicker Grid.Column="0" SelectedDate="{Binding DateFrom}" Height="36" Margin="0,0,6,0"/>
            <DatePicker Grid.Column="1" SelectedDate="{Binding DateTo}"   Height="36" Margin="0,0,6,0"/>

            <Button Grid.Column="2" Content="Apply" Style="{StaticResource PrimaryBtn}"
                    Padding="16,0" Margin="0,0,6,0" Command="{Binding RefreshCommand}"/>
            <Button Grid.Column="3" Content="This Month" Style="{StaticResource SecondaryBtn}"
                    Padding="14,0" Margin="0,0,6,0" Command="{Binding ThisMonthCommand}"/>
            <Button Grid.Column="4" Content="Last Month" Style="{StaticResource SecondaryBtn}"
                    Padding="14,0" Command="{Binding LastMonthCommand}"/>
        </Grid>

        <!-- 무엇을 무엇과 비교한 값인지. 이게 없으면 증감 숫자를 신뢰할 수 없다. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="{Binding PeriodLabel}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ComparisonLabel}" FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 요약 카드 4개 -->
        <UniformGrid Grid.Row="3" Columns="4" Margin="0,0,0,18">
            <Border Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="Sales Amount" Style="{StaticResource SummaryLabel}"/>
                    <TextBlock Text="{Binding Report.Current.Amount}" Style="{StaticResource SummaryValue}"/>
                    <!-- 화살표만 방향색을 입히고 "vs 이전값"은 흐린 글씨로 둔다.
                         줄 전체가 붉으면 비교 대상 숫자까지 경고처럼 읽힌다. -->
                    <TextBlock Style="{StaticResource SummaryChange}">
                        <Run Text="{Binding Report.AmountChange, Mode=OneWay}"
                             Foreground="{Binding Report.AmountDirection, Converter={StaticResource ChangeBrush}}"
                             FontWeight="SemiBold"/>
                        <Run Text="{Binding Report.AmountDelta, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="Transactions" Style="{StaticResource SummaryLabel}"/>
                    <TextBlock Text="{Binding Report.Current.TransactionCount}" Style="{StaticResource SummaryValue}"/>
                    <TextBlock Style="{StaticResource SummaryChange}">
                        <Run Text="{Binding Report.TransactionChange, Mode=OneWay}"
                             Foreground="{Binding Report.TransactionDirection, Converter={StaticResource ChangeBrush}}"
                             FontWeight="SemiBold"/>
                        <Run Text="{Binding Report.TransactionDelta, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="Units Sold" Style="{StaticResource SummaryLabel}"/>
                    <TextBlock Text="{Binding Report.Current.ItemCount}" Style="{StaticResource SummaryValue}"/>
                    <TextBlock Style="{StaticResource SummaryChange}">
                        <Run Text="{Binding Report.ItemChange, Mode=OneWay}"
                             Foreground="{Binding Report.ItemDirection, Converter={StaticResource ChangeBrush}}"
                             FontWeight="SemiBold"/>
                        <Run Text="{Binding Report.ItemDelta, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 복약안내가 실제로 전달되고 있는지. 이 기능이 하는 일이 그것이라
                 요약 카드 한 자리를 여기에 쓴다.

                 ACCESS 비중이 있던 자리다. 그 값은 바로 아래 등급별 비율이 네 등급과
                 함께 보여주므로 같은 숫자를 두 번 둘 이유가 없었다. -->
            <Border Style="{StaticResource SummaryCard}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Counselling Print Rate" Style="{StaticResource SummaryLabel}"/>
                    <TextBlock Text="{Binding CounsellingPrintRateDisplay}" Style="{StaticResource SummaryValue}"/>
                    <TextBlock Text="{Binding CounsellingSummary}" Style="{StaticResource SummaryChange}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 두 표를 좌우로 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 상품별 순위 -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 정렬 기준을 바꿔도 다시 조회하지 않는다 (집계값은 같다). -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="105"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Product Ranking"
                               Style="{StaticResource SectionTitle}" Margin="0"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2" Text="Sort by" FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="3" Height="30"
                              ItemsSource="{Binding AvailableSorts}"
                              SelectedItem="{Binding SelectedSort}"/>
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Products}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          BorderThickness="1"
                          BorderBrush="{StaticResource BorderBrushSoft}"
                          RowBackground="White"
                          AlternatingRowBackground="{StaticResource SubtleSurfaceBrush}"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderBrushSoft}"
                          RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"      Binding="{Binding Rank}"     Width="36"/>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Qty"    Binding="{Binding Quantity}" Width="60"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount}"   Width="90"/>
                        <!-- 순위표에서는 전기 대비 증감보다 "이 약이 매출의 얼마를 차지하는가"가
                             읽을 값이다. 순위 자체가 이미 크기순이므로, 1위가 전체의 40%인지
                             4%인지가 그다음 질문이 된다. 증감은 위쪽 요약 카드가 맡는다.
                             분모는 이 표에 실린 줄들의 합이라 비중을 다 더하면 100%다. -->
                        <DataGridTextColumn Header="Share" Binding="{Binding AmountShare}" Width="70"
                                            ElementStyle="{StaticResource ChangeCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- 항생제 관련 정보는 전부 이 오른쪽 칸에 모은다.
                 등급별 비율 → 성분별 표 → (아래) 12개월 추이 순서다.
                 왼쪽은 약국 전체 매출, 오른쪽은 항생제 — 두 축을 섞지 않는다. -->
            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── 등급별 비율 ──────────────────────────────────────────
                     요약 카드는 ACCESS 비중 하나만 보여준다. WHO 권고(70% 이상)를 한 값으로
                     읽기에는 그게 맞지만, ACCESS가 낮을 때 남은 몫이 WATCH인지 RESERVE인지는
                     해야 할 일이 전혀 다르다.

                     판매가 없는 등급도 0%로 남긴다 — 목록에서 빠지면 "0이었다"와
                     "그런 등급이 없다"를 구분할 수 없다. -->
                <TextBlock Grid.Row="0" Text="AWaRe Group Share" Style="{StaticResource SectionTitle}"/>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding GroupShares}" Margin="0,0,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>

                                <!-- 색 점. 아래 추이 그래프와 같은 색이라 범례가 두 곳에서 같다. -->
                                <Border Grid.Column="0" Width="9" Height="9" CornerRadius="5"
                                        Background="{Binding Group, Converter={StaticResource AwareBrush}}"
                                        VerticalAlignment="Center" Margin="0,0,7,0"/>

                                <TextBlock Grid.Column="1" Text="{Binding Group}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center"/>

                                <!-- 막대를 픽셀이 아니라 두 칸의 별(*) 비율로 그린다.
                                     남은 공간은 배치가 끝나야 정해지는 값이라 미리 계산할 수 없고,
                                     이렇게 두면 창을 줄여도 비율이 그대로 유지된다. -->
                                <Border Grid.Column="2" Height="6" CornerRadius="3"
                                        VerticalAlignment="Center" Margin="0,0,10,0"
                                        Background="{StaticResource FieldBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionStar}}"/>
                                            <ColumnDefinition Width="{Binding Remainder, Converter={StaticResource FractionStar}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="3"
                                                Background="{Binding Group, Converter={StaticResource AwareBrush}}"/>
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Column="3" Text="{Binding ShareDisplay}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <!-- 비중 옆의 실제 수량. 0.5%가 1개인지 500개인지는 비중만으로 알 수 없다. -->
                                <TextBlock Grid.Column="4" Text="{Binding QuantityDisplay, StringFormat={}{0} units}"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="2" Text="Antibiotics by Ingredient"
                           Style="{StaticResource SectionTitle}" Margin="0,10,0,8"/>

                <DataGrid Grid.Row="3"
                          ItemsSource="{Binding Antibiotics}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          BorderThickness="1"
                          BorderBrush="{StaticResource BorderBrushSoft}"
                          RowBackground="White"
                          AlternatingRowBackground="{StaticResource SubtleSurfaceBrush}"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderBrushSoft}"
                          RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ingredient" Binding="{Binding Ingredient}" Width="*"/>
                        <DataGridTextColumn Header="Strength"   Binding="{Binding Strength}"   Width="70"/>
                        <DataGridTextColumn Header="Group"      Binding="{Binding AwareGroup}" Width="90"/>
                        <DataGridTextColumn Header="Qty"        Binding="{Binding Quantity}"   Width="50"/>
                        <DataGridTextColumn Header="Qty vs prev" Binding="{Binding QuantityChange}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ChangeCell}">
                                    <Setter Property="Foreground"
                                            Value="{Binding QuantityDirection, Converter={StaticResource ChangeBrush}}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- "6 / 8" = 판매 8건 중 6건에 복약안내가 나갔다는 뜻 -->
                        <DataGridTextColumn Header="Counselled" Binding="{Binding CounsellingDisplay}" Width="80"/>
                        <!-- 복약안내 출력률이 아니라 "이 성분이 기간 내 항생제 판매에서 차지하는 비중"이다.
                             출력률은 위 요약 카드가 기간 전체를 한 줄로 보여주므로 표에서 겹쳐 둘 이유가 없고,
                             상품 표의 Share와 같은 이름·같은 자리라 두 표를 같은 방식으로 읽게 된다. -->
                        <DataGridTextColumn Header="Share"      Binding="{Binding QuantityShare}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            <!-- 항생제 표가 비면 왜 비었는지 알려 준다. 데이터가 없는 건지 기능을 안 쓴 건지 구분이 안 되기 때문이다. -->
            <TextBlock Grid.Row="4"
                       Text="No antibiotic sales recorded in this period. This table is built from counselling records, so sales made before the counselling feature was in use do not appear."
                       TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAntibioticData}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            </Grid>
        </Grid>

        <!-- ── 하단 그래프 두 개 ────────────────────────────────────────────
             왼쪽은 약국 전체 순매출, 오른쪽은 항생제. 위쪽 두 표와 같은 좌우 구분이라
             화면 전체가 "왼쪽 = 전체 / 오른쪽 = 항생제" 한 규칙으로 읽힌다.

             둘 다 고른 기간이 아니라 그 기간이 끝나는 달까지의 12개월이다. 한 달치 표만
             봐서는 그 달이 평소보다 많은지 적은지 알 수 없어서 둔 것이고, 두 그래프가
             같은 창·같은 치수(TrendChartMetrics)를 쓰므로 가로축이 정확히 겹친다.

             차트 패키지를 쓰지 않는다. 이 저장소는 바코드도 사각형으로 직접 그리고 있고,
             막대 24개에 패키지 의존성을 더할 이유가 없다. -->
        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── 매출 추이 ───────────────────────────────────────────────── -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="Sales, Last 12 Months"
                                   Style="{StaticResource SectionTitle}" Margin="0"/>
                        <!-- 고른 기간과 다른 구간이라는 사실을 적어 둔다. 이게 없으면
                             위 카드의 금액과 그래프의 합이 왜 다른지 알 수 없다. -->
                        <TextBlock Text="{Binding TrendPeriodLabel}"
                                   Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <Grid Visibility="{Binding HasSalesTrendData, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 세로축. 가장 큰 달이 얼마였는지 적어야 막대 높이를 숫자로 읽을 수 있다. -->
                        <Grid Grid.Column="0" MinWidth="40" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="132"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="1" Text="{Binding SalesTrendMaxDisplay}"
                                       FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="1" Text="0"
                                       FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>

                        <ItemsControl Grid.Column="1" ItemsSource="{Binding SalesTrendBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Background를 투명으로 두는 이유: 색 없는 칸에는 마우스가
                                         닿지 않아 툴팁이 뜨지 않는다. -->
                                    <Grid Margin="3,0" Background="Transparent" ToolTip="{Binding Tooltip}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="18"/>
                                            <RowDefinition Height="132"/>
                                            <RowDefinition Height="20"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="{Binding AmountDisplay}"
                                                   FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"/>

                                        <Border Grid.Row="1" VerticalAlignment="Bottom"
                                                Height="{Binding Height}"
                                                Background="{StaticResource PrimaryBrush}"/>

                                        <TextBlock Grid.Row="2" Text="{Binding Label}"
                                                   FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <TextBlock Text="No sales in the last 12 months."
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSalesTrendData}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ── 항생제 추이 ─────────────────────────────────────────────
                 등급으로 쌓아 올리는 이유: 총량이 그대로여도 WATCH·RESERVE 쪽으로
                 옮겨가는 중이면 상황이 나빠지고 있는 것이다. 총량만 그리면 그 이동이
                 보이지 않는다. -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,14" Margin="8,0,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Antibiotic Sales, Last 12 Months"
                                   Style="{StaticResource SectionTitle}" Margin="0"
                                   VerticalAlignment="Center"/>

                        <!-- 범례. 위 등급별 비율과 같은 목록·같은 색을 쓴다. -->
                        <ItemsControl ItemsSource="{Binding GroupShares}" HorizontalAlignment="Right">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <Border Width="9" Height="9" CornerRadius="5"
                                                Background="{Binding Group, Converter={StaticResource AwareBrush}}"
                                                VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Group}" FontSize="10"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <Grid Visibility="{Binding HasTrendData, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" MinWidth="40" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="132"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="1" Text="{Binding TrendMaxDisplay}"
                                       FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="1" Text="0"
                                       FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>

                        <ItemsControl Grid.Column="1" ItemsSource="{Binding TrendBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="3,0" Background="Transparent" ToolTip="{Binding Tooltip}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="18"/>
                                            <RowDefinition Height="132"/>
                                            <RowDefinition Height="20"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="{Binding TotalDisplay}"
                                                   FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"/>

                                        <!-- 아래에서부터 ACCESS·WATCH·RESERVE·NOT_RECOMMENDED 순으로 쌓는다.
                                             StackPanel의 자식은 위에서 아래로 놓이므로 순서가 뒤집혀 있다. -->
                                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                                            <Border Height="{Binding NotRecommendedHeight}"
                                                    Background="{StaticResource AwareNotRecommendedBrush}"/>
                                            <Border Height="{Binding ReserveHeight}"
                                                    Background="{StaticResource AwareReserveBrush}"/>
                                            <Border Height="{Binding WatchHeight}"
                                                    Background="{StaticResource AwareWatchBrush}"/>
                                            <Border Height="{Binding AccessHeight}"
                                                    Background="{StaticResource AwareAccessBrush}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Text="{Binding Label}"
                                                   FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <TextBlock Text="No antibiotic sales in the last 12 months. This chart is built from counselling records, so sales made before the counselling feature was in use do not appear."
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTrendData}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 하단: 뒤로 + 내보내기 + 메시지 -->
        <Grid Grid.Row="6" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="← Back"
                    Style="{StaticResource SecondaryBtn}"
                    Padding="16,0" Command="{Binding BackCommand}"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding Message}"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" FontSize="13"
                       VerticalAlignment="Center" Margin="12,0,12,0"/>

            <Button Grid.Column="2" Content="Export CSV"
                    Style="{StaticResource SecondaryBtn}"
                    Padding="16,0" Command="{Binding ExportCommand}"/>
        </Grid>
    </Grid>
</UserControl>
