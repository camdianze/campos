<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.PosSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Lightweight_Digital_Inventory_Management___POS_System.Converters"
             mc:Ignorable="d"
             Background="White"
             d:DesignWidth="1000" d:DesignHeight="700"
             PreviewTextInput="OnPreviewTextInput">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,20">

        <!-- 제목 -->
        <TextBlock DockPanel.Dock="Top"
                   Text="POS Sale"
                   Style="{StaticResource PageTitle}"
                   Margin="0,0,0,12"/>

        <!-- 바코드 검색 -->
        <TextBox DockPanel.Dock="Top"
                 x:Name="SearchBox"
                 Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="OnSearchBoxKeyDown"
                 Height="48"
                 FontSize="16"
                 Padding="16,0"
                 Margin="0,0,0,6"/>

        <!-- 검색 결과 -->
        <ListBox DockPanel.Dock="Top"
                 ItemsSource="{Binding SearchResults}"
                 SelectedItem="{Binding SelectedProduct}"
                 DisplayMemberPath="ProductName"
                 MaxHeight="90"
                 BorderBrush="{StaticResource BorderBrushSoft}"
                 BorderThickness="1"
                 FontSize="13"
                 Margin="0,0,0,10"/>

        <!-- 뒤로 + 메시지. 다른 화면과 같이 뒤로 버튼은 왼쪽 아래에 둔다. -->
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="{Binding BackLabel}" FontFamily="{StaticResource KhmerFont}" Foreground="{Binding LabelBrush}"
                    Style="{StaticResource SecondaryBtn}"
                    Padding="16,0"
                    Click="OnBackClick"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding Message}"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" FontSize="13"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"/>
        </Grid>

        <!-- 메인 2단 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측: 장바구니 -->
            <Grid Grid.Column="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Cart"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Cart}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          BorderThickness="1"
                          BorderBrush="{StaticResource BorderBrushSoft}"
                          RowBackground="White"
                          AlternatingRowBackground="{StaticResource SubtleSurfaceBrush}"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderBrushSoft}"
                          RowHeight="38">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product"  Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Batch"    Binding="{Binding BatchNumber}" Width="90"/>
                        <DataGridTextColumn Header="Qty"      Binding="{Binding Quantity}"    Width="50"/>
                        <!-- Qty가 박스 개수인지 낱개 개수인지는 이 컬럼으로만 구분된다. -->
                        <DataGridTextColumn Header="Unit"     Binding="{Binding SaleUnitLabel}" Width="55"/>
                        <DataGridTextColumn Header="Price"    Binding="{Binding UnitPrice}"   Width="80"/>
                        <DataGridTextColumn Header="Total"    Binding="{Binding LineTotal}"   Width="80"/>
                        <DataGridTemplateColumn Header="" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding DataContext.RemoveLabel,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            FontFamily="{StaticResource KhmerFont}"
                                            Style="{StaticResource SoftDangerBtn}"
                                            Command="{Binding DataContext.RemoveFromCartCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- 우측: 주문 패널 -->
            <Border Grid.Column="1"
                    Background="{StaticResource SubtleSurfaceBrush}"
                    CornerRadius="12"
                    Padding="14">
                <StackPanel>

                    <!-- 선택 상품 -->
                    <TextBlock Text="Selected Product"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedProduct.ProductName}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                               MinHeight="18" Margin="0,0,0,10"/>

                    <!-- Batch -->
                    <TextBlock Text="Batch Number" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Batches}"
                              SelectedItem="{Binding SelectedBatch}"
                              DisplayMemberPath="BatchNumber"
                              Height="34" Margin="0,0,0,8"/>

                    <!-- 박스/낱개. 바코드를 찍으면 자동으로 정해지고, 이름으로 찾았을 때만
                         손으로 고르면 된다. 구분이 없는 상품에는 아예 나타나지 않는다. -->
                    <StackPanel Visibility="{Binding IsBoxedProductSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Sell As" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailableSaleUnits}"
                                  SelectedItem="{Binding SelectedSaleUnit}"
                                  Height="34" Margin="0,0,0,8"/>
                    </StackPanel>

                    <!-- 수량 -->
                    <TextBlock Text="{Binding QuantityLabel}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInput}" Margin="0,0,0,8"/>

                    <!-- 가격 -->
                    <TextBlock Text="Selling Price" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding CanEditUnitPrice, Converter={StaticResource InverseBoolConverter}}"
                             Style="{StaticResource FieldInput}" Margin="0,0,0,10"/>

                    <!-- Add to Cart -->
                    <Button Content="{Binding AddToCartLabel}" FontFamily="{StaticResource KhmerFont}"
                            Style="{StaticResource PrimaryBtn}"
                            Height="38"
                            Command="{Binding AddToCartCommand}"
                            Margin="0,0,0,12"/>

                    <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="0,0,0,12"/>

                    <!-- 결제 -->
                    <TextBlock Text="Payment Method" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding AvailablePaymentMethods}"
                              SelectedItem="{Binding SelectedPaymentMethod}"
                              Height="34" Margin="0,0,0,8"/>

                    <StackPanel Visibility="{Binding IsCashPayment, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Cash Tendered" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CashTendered, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldInput}" Margin="0,0,0,8"/>
                    </StackPanel>

                    <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInput}" Margin="0,0,0,12"/>

                    <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="0,0,0,10"/>

                    <!-- 합계 -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Total" FontSize="13" Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalAmount}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel Visibility="{Binding IsCashPayment, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="Change" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ChangeDue}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="#38A169"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <!-- 버튼 -->
                    <Button Content="{Binding ConfirmSaleLabel}" FontFamily="{StaticResource KhmerFont}"
                            Style="{StaticResource PrimaryBtn}"
                            Height="42" FontSize="14"
                            Command="{Binding ConfirmSaleCommand}"
                            Margin="0,0,0,6"/>

                    <Button Content="{Binding CancelSaleLabel}" FontFamily="{StaticResource KhmerFont}"
                            Style="{StaticResource SecondaryBtn}"
                            Height="34"
                            Command="{Binding CancelSaleCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>