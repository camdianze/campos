<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.PosSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Lightweight_Digital_Inventory_Management___POS_System.Converters"
             mc:Ignorable="d"
             Background="White"
             d:DesignWidth="1000" d:DesignHeight="700">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanConverter x:Key="InverseBoolConverter"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#6C757D"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Background"               Value="#F3F3F3"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Height"                   Value="36"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Padding"                  Value="10,8"/>
            <Setter Property="Foreground"               Value="#212529"/>
            <Setter Property="CaretBrush"               Value="#212529"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PriBtn" TargetType="Button">
            <Setter Property="Background"      Value="#BF5B92E5"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#BBBBBB"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecBtn" TargetType="Button" BasedOn="{StaticResource PriBtn}">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#121212"/>
        </Style>

        <Style x:Key="RemoveBtn" TargetType="Button">
            <Setter Property="Background"      Value="#FFE8E8"/>
            <Setter Property="Foreground"      Value="#E53E3E"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,20">

        <!-- 제목 + 뒤로 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="POS Sale"
                       FontSize="28" FontWeight="Light"
                       Foreground="#121212"/>
            <Button Content="← Back"
                    Style="{StaticResource SecBtn}"
                    HorizontalAlignment="Right"
                    Padding="16,0"
                    Click="OnBackClick"/>
        </Grid>

        <!-- 바코드 검색 -->
        <TextBox DockPanel.Dock="Top"
                 x:Name="SearchBox"
                 Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="OnSearchBoxKeyDown"
                 Background="#F3F3F3"
                 BorderThickness="0"
                 Height="48"
                 FontSize="16"
                 Padding="16,0"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,6"/>

        <!-- 검색 결과 -->
        <ListBox DockPanel.Dock="Top"
                 ItemsSource="{Binding SearchResults}"
                 SelectedItem="{Binding SelectedProduct}"
                 DisplayMemberPath="ProductName"
                 MaxHeight="90"
                 BorderBrush="#E0E0E0"
                 BorderThickness="1"
                 FontSize="13"
                 Margin="0,0,0,10"/>

        <!-- 메시지 -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding Message}"
                   Foreground="#E53E3E"
                   TextWrapping="Wrap" FontSize="13"
                   Margin="0,6,0,0"/>

        <!-- 메인 2단 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측: 장바구니 -->
            <Grid Grid.Column="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Cart"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="#121212" Margin="0,0,0,8"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Cart}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          BorderThickness="1"
                          BorderBrush="#E0E0E0"
                          RowBackground="White"
                          AlternatingRowBackground="#F8F9FA"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E0E0E0"
                          RowHeight="38">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"      Value="#F1F3F5"/>
                            <Setter Property="Foreground"      Value="#6C757D"/>
                            <Setter Property="FontSize"        Value="12"/>
                            <Setter Property="FontWeight"      Value="SemiBold"/>
                            <Setter Property="Padding"         Value="10,0"/>
                            <Setter Property="Height"          Value="36"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush"     Value="#E0E0E0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product"  Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Batch"    Binding="{Binding BatchNumber}" Width="90"/>
                        <DataGridTextColumn Header="Qty"      Binding="{Binding Quantity}"    Width="50"/>
                        <DataGridTextColumn Header="Price"    Binding="{Binding UnitPrice}"   Width="80"/>
                        <DataGridTextColumn Header="Total"    Binding="{Binding LineTotal}"   Width="80"/>
                        <DataGridTemplateColumn Header="" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove"
                                            Style="{StaticResource RemoveBtn}"
                                            Command="{Binding DataContext.RemoveFromCartCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- 우측: 주문 패널 -->
            <Border Grid.Column="1"
                    Background="#F8F9FA"
                    CornerRadius="12"
                    Padding="14">
                <StackPanel>

                    <!-- 선택 상품 -->
                    <TextBlock Text="Selected Product"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#6C757D" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedProduct.ProductName}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#121212" TextWrapping="Wrap"
                               MinHeight="18" Margin="0,0,0,10"/>

                    <!-- Batch -->
                    <TextBlock Text="Batch Number" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Batches}"
                              SelectedItem="{Binding SelectedBatch}"
                              DisplayMemberPath="BatchNumber"
                              Height="34" Margin="0,0,0,8"/>

                    <!-- 수량 -->
                    <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInput}" Margin="0,0,0,8"/>

                    <!-- 가격 -->
                    <TextBlock Text="Selling Price" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding CanEditUnitPrice, Converter={StaticResource InverseBoolConverter}}"
                             Style="{StaticResource FieldInput}" Margin="0,0,0,10"/>

                    <!-- Add to Cart -->
                    <Button Content="＋  Add to Cart"
                            Style="{StaticResource PriBtn}"
                            Height="38"
                            Command="{Binding AddToCartCommand}"
                            Margin="0,0,0,12"/>

                    <Border Height="1" Background="#E0E0E0" Margin="0,0,0,12"/>

                    <!-- 결제 -->
                    <TextBlock Text="Payment Method" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding AvailablePaymentMethods}"
                              SelectedItem="{Binding SelectedPaymentMethod}"
                              Height="34" Margin="0,0,0,8"/>

                    <StackPanel Visibility="{Binding IsCashPayment, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Cash Tendered" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CashTendered, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldInput}" Margin="0,0,0,8"/>
                    </StackPanel>

                    <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInput}" Margin="0,0,0,12"/>

                    <Border Height="1" Background="#E0E0E0" Margin="0,0,0,10"/>

                    <!-- 합계 -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Total" FontSize="13" Foreground="#6C757D"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalAmount}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="#121212"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel Visibility="{Binding IsCashPayment, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="Change" FontSize="12" Foreground="#6C757D"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ChangeDue}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="#38A169"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <!-- 버튼 -->
                    <Button Content="✓  Confirm Sale"
                            Style="{StaticResource PriBtn}"
                            Height="42" FontSize="14"
                            Command="{Binding ConfirmSaleCommand}"
                            Margin="0,0,0,6"/>

                    <Button Content="✕  Cancel Sale"
                            Style="{StaticResource SecBtn}"
                            Height="34"
                            Command="{Binding CancelSaleCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>