<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.BackupExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Lightweight_Digital_Inventory_Management___POS_System.Converters"
             xmlns:ctl="clr-namespace:Lightweight_Digital_Inventory_Management___POS_System.Controls"
             mc:Ignorable="d"
             Background="White"
             d:DesignWidth="960" d:DesignHeight="700">

    <!--
        화면을 좌우로 나눈 기준은 데이터가 흐르는 방향이다.
        왼쪽은 파일 → 앱(가져오기), 오른쪽은 앱 → 파일(내보내기·백업).
        그 아래가 앱 → 서버(동기화)이고, 복원만 맨 아래 위험 구역에 따로 두었다.

        위에서 아래로 되돌리기 어려운 순서다: 가져오기·내보내기는 다시 하면 되고,
        보낸 묶음은 되돌릴 수 없으며, 복원은 지금 있는 것을 버린다.
    -->
    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource SubtleSurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="18,16"/>
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>

        <Style x:Key="PanelHint" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Foreground"   Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Width="900" Margin="0,24,0,24" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Data Center"
                       Style="{StaticResource PageTitle}"
                       Margin="0,0,0,20"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══ 좌: 가져오기 (파일 → 앱) ═══ -->
                <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="IMPORT" Style="{StaticResource EyebrowLabel}"/>
                        <TextBlock Text="File to app" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Style="{StaticResource PanelHint}" Margin="0,0,0,14"
                                   Text="One CSV or Excel file registers products and stock, in two steps. Use the same file for ① and then ②."/>

                        <TextBlock Text="File" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding ImportFilePath}"
                                     IsReadOnly="True"
                                     Style="{StaticResource FieldInput}"
                                     Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse"
                                    Style="{StaticResource SecondaryBtn}"
                                    Padding="12,0"
                                    Command="{Binding SelectImportFileCommand}"/>
                        </Grid>

                        <!-- 통화는 ① 바로 위에 둔다. 가격을 읽는 것은 ①뿐이고,
                             파일을 고른 다음 누르기 직전에 눈에 들어와야 한다. -->
                        <TextBlock Text="Prices in the file are" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="$  US dollars" Height="34" MinWidth="120"
                                    FontSize="13" FontWeight="SemiBold" Padding="12,0"
                                    Command="{Binding ReadPricesInUsdCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUsdImport}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="៛  Riel" Height="34" MinWidth="120"
                                    FontSize="13" FontWeight="SemiBold" Padding="12,0"
                                    Margin="8,0,0,0"
                                    Command="{Binding ReadPricesInRielCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRielImport}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource PanelHint}" Margin="0,0,0,12"
                                   Text="Applies to cost_price, selling_price and loose_unit_price in step ①. A cell that says 6000 KHR or $1.50 is read that way whichever button is on. Riel is converted at the rate in Receipt Settings; prices are always stored in dollars. Switch to $ for a file this app exported — those are written in dollars."/>

                        <CheckBox Content="Work out a loose unit price where the file has none"
                                  IsChecked="{Binding AssumeLoosePrices}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource PanelHint}" Margin="0,0,0,12"
                                   Text="Box price divided by the count, rounded up to a payable amount, and loose sale switched on. Only for pharmacies that price loose units that way - a price already set is never overwritten, and the preview says how many products get one."/>

                        <Button Content="①  Import Products"
                                Style="{StaticResource PrimaryBtn}"
                                Padding="16,0" HorizontalAlignment="Stretch"
                                Margin="0,0,0,4"
                                Command="{Binding ImportProductsCommand}"/>
                        <TextBlock Style="{StaticResource PanelHint}" Margin="0,0,0,12"
                                   Text="Adds new products. For products that already exist, only the columns filled in the file are updated — empty columns are left as they are."/>

                        <Button Content="②  Import Inventory"
                                Style="{StaticResource PrimaryBtn}"
                                Padding="16,0" HorizontalAlignment="Stretch"
                                Margin="0,0,0,4"
                                Command="{Binding ImportInventoryCommand}"/>
                        <TextBlock Style="{StaticResource PanelHint}" Margin="0,0,0,14"
                                   Text="Adds stock batch by batch, recorded as stock-in. quantity is the number of boxes (loose units go in loose_quantity). Put N in expiry_date when the expiry date is unknown."/>

                        <Button Content="&#x2462;  Import Photos"
                                Style="{StaticResource PrimaryBtn}"
                                Padding="16,0" HorizontalAlignment="Stretch"
                                Margin="0,0,0,4"
                                Command="{Binding ImportPhotosCommand}"/>
                        <TextBlock Style="{StaticResource PanelHint}" Margin="0,0,0,14"
                                   Text="Asks for a folder instead of a file. Name each photo after the product's barcode - 8801234567890.jpg. For a product with only an internal barcode the issued number alone is enough: INT-00000146 takes 146.jpg. The product name works too. Use JPG; photos straight off an iPhone are HEIC and cannot be read."/>

                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="File columns" Style="{StaticResource FieldLabel}"/>
                                <!-- 무엇이 필수인지 정확히 적는다. 전에는 읽는 컬럼을 한 줄에
                                     늘어놓고 다음 줄에만 "Optional:"을 붙여서, cost_price처럼
                                     사실은 비워도 되는 칸이 필수처럼 읽혔다. 시트는 비우라고
                                     안내하는데 화면은 요구하는 것처럼 보이면 아무도 믿지 않는다. -->
                                <TextBlock Style="{StaticResource PanelHint}"
                                           Text="Required for a new product: product_name, manufacturer, dosage_form, unit, selling_price. generic_name too, unless dosage_form is Other (bandages, masks…). manufacturer is what tells two makers' versions of one name apart."/>
                                <TextBlock Style="{StaticResource PanelHint}" Margin="0,6,0,0"
                                           Text="Optional: barcode, cost_price, safety_stock, units_per_box, loose_unit_price, strength, atc_code, is_combination, country_of_origin, status. An exported products file can be edited and imported straight back."/>
                                <TextBlock Style="{StaticResource PanelHint}" Margin="0,6,0,0"
                                           Text="Step 2 reads: batch_number, expiry_date, quantity, loose_quantity."/>
                                <TextBlock Style="{StaticResource PanelHint}" Margin="0,6,0,0"
                                           Text="Prices are in dollars unless the cell says otherwise. Write 1000 KHR (or 1000៛) to give a price in riel, and it is converted at the rate in Receipt Settings."/>
                                <TextBlock Style="{StaticResource PanelHint}" Margin="0,6,0,0"
                                           Text="dosage_form is the form of the medicine (Tablet, Syrup, Injection, Ointment…), while unit is how one piece is counted (Tablet, Bottle, Tube). A file with only product_name and dosage_form fills the form in for products that already exist."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══ 우: 내보내기 (앱 → 파일) ═══ -->
                <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="EXPORT / BACKUP" Style="{StaticResource EyebrowLabel}"/>
                        <TextBlock Text="App to file" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Style="{StaticResource PanelHint}" Margin="0,0,0,14"
                                   Text="Writes the data currently stored in the app to files. Nothing in the app changes."/>

                        <TextBlock Text="Folder" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding ExportFolder}"
                                     IsReadOnly="True"
                                     Style="{StaticResource FieldInput}"
                                     Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse"
                                    Style="{StaticResource SecondaryBtn}"
                                    Padding="12,0"
                                    Command="{Binding SelectExportFolderCommand}"/>
                        </Grid>

                        <TextBlock Text="What to export" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Margin="0,0,0,10">
                            <CheckBox Content="Products — product list"
                                      IsChecked="{Binding ExportProducts}"
                                      Foreground="{StaticResource TextBrush}" FontSize="13"
                                      Margin="0,0,0,6"/>
                            <CheckBox Content="Inventory — stock by batch"
                                      IsChecked="{Binding ExportInventory}"
                                      Foreground="{StaticResource TextBrush}" FontSize="13"
                                      Margin="0,0,0,6"/>
                            <CheckBox Content="Sales history — sales and refunds"
                                      IsChecked="{Binding ExportSalesHistory}"
                                      Foreground="{StaticResource TextBrush}" FontSize="13"/>
                        </StackPanel>

                        <!-- 기간. 판매 내역에만 걸린다 — 상품은 현재 카탈로그라 잘라내면
                             고쳐서 다시 넣는 왕복이 깨지고, 재고는 배치별 현재 수량이라
                             기간이라는 게 없다. -->
                        <TextBlock Text="Period (sales history only)" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0" SelectedDate="{Binding ExportDateFrom}" Margin="0,0,4,0"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding ExportDateTo}" Margin="4,0,0,0"/>
                        </Grid>
                        <TextBlock Style="{StaticResource PanelHint}" Margin="0,0,0,12"
                                   Text="Leave both empty to export every sale ever recorded — you will be asked to confirm. Products and inventory always export in full: one is the current catalogue, the other the current stock count."/>

                        <TextBlock Text="Format" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Content="CSV" IsChecked="{Binding IsCsvFormat}"
                                         Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,0,16,0"/>
                            <RadioButton Content="Excel"
                                         IsChecked="{Binding IsCsvFormat, Converter={StaticResource InverseBoolConverter}}"
                                         Foreground="{StaticResource TextBrush}" FontSize="13"/>
                        </StackPanel>

                        <Button Content="📤  Export Selected Data"
                                Style="{StaticResource PrimaryBtn}"
                                Padding="16,0" HorizontalAlignment="Stretch"
                                Margin="0,0,0,4"
                                Command="{Binding ExportDataCommand}"/>
                        <TextBlock Style="{StaticResource PanelHint}" Margin="0,0,0,16"
                                   Text="One file per selected item. These files are for reading and record keeping — they cannot be restored."/>

                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                CornerRadius="8" Padding="12,12">
                            <StackPanel>
                                <TextBlock Text="Full backup (.db)" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Style="{StaticResource PanelHint}" Margin="0,0,0,10"
                                           Text="Copies the whole database into a single file. This is the only file the restore below can read."/>
                                <Button Content="💾  Create Backup File"
                                        Style="{StaticResource SecondaryBtn}"
                                        Padding="16,0" HorizontalAlignment="Stretch"
                                        Command="{Binding CreateDbBackupCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ 가운데: 서버 동기화 ═══ -->
            <!-- 가져오기·내보내기와 같은 화면에 두는 이유는 셋 다 "데이터가 앱을
                 드나드는 일"이기 때문이다. 관리자 대시보드에 따로 두었더니 백업을
                 찾던 사람이 둘을 다른 종류의 일로 읽었다. 복원 위에 두는 것은
                 되돌릴 수 없는 정도 순서다 — 동기화는 보낸 것을 되돌릴 수 없고,
                 복원은 지금 있는 것을 버린다. -->
            <Border Grid.Row="2" Style="{StaticResource PanelCard}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="SERVER SYNC" Style="{StaticResource EyebrowLabel}"/>
                    <TextBlock Text="App to server" Style="{StaticResource PanelTitle}"/>
                    <TextBlock Style="{StaticResource PanelHint}" Margin="0,0,0,14"
                               Text="Set up once per computer. The address and the publishable key are the same for every pharmacy; the token is this computer's own."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 왼쪽: 연결 설정 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Server address" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SyncServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldInput}"
                                     IsEnabled="{Binding IsSyncIdle}"
                                     Margin="0,0,0,10"/>

                            <TextBlock Text="Publishable key" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SyncPublishableKey, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldInput}"
                                     IsEnabled="{Binding IsSyncIdle}"
                                     Margin="0,0,0,10"/>

                            <!-- 토큰만 비밀이라 PasswordField를 쓴다. 눈 버튼이 있어야
                                 64자짜리 hex를 붙여넣고 맞는지 볼 수 있다. -->
                            <TextBlock Text="Device token" Style="{StaticResource FieldLabel}"/>
                            <ctl:PasswordField x:Name="SyncTokenInput" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource PanelHint}" Margin="0,0,0,12"
                                       Text="Stored encrypted for this Windows account only, so a copied database cannot sync from another computer. Never paste the server's secret key here."/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Save"
                                        Style="{StaticResource PrimaryBtn}"
                                        Padding="20,0" Margin="0,0,8,0"
                                        IsEnabled="{Binding IsSyncIdle}"
                                        Click="OnSaveSyncSettingsClick"/>
                                <Button Content="Test Connection"
                                        Style="{StaticResource SecondaryBtn}"
                                        Padding="16,0"
                                        IsEnabled="{Binding IsSyncIdle}"
                                        Click="OnTestSyncConnectionClick"/>
                            </StackPanel>

                            <TextBlock Text="{Binding SyncStatusMessage}"
                                       Style="{StaticResource PanelHint}" TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                        </StackPanel>

                        <!-- 오른쪽: 무엇이 나가는지 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="What gets sent" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Style="{StaticResource PanelHint}" Margin="0,0,0,10"
                                       Text="Products, stock by batch, the stock ledger, counselling records, and staff names with their roles. No passwords and no customer details — there is no column for them on the server."/>

                            <!-- 보내는 버튼. 위의 미리보기와 생김새를 다르게 두는
                                 것은 둘의 무게가 다르기 때문이다 — 하나는 파일을
                                 쓰고, 하나는 되돌릴 수 없다. -->
                            <Button Content="⬆  Synchronize"
                                    Style="{StaticResource PrimaryBtn}"
                                    Padding="20,0" HorizontalAlignment="Stretch"
                                    Margin="0,0,0,8"
                                    IsEnabled="{Binding IsSyncIdle}"
                                    Command="{Binding SynchronizeCommand}"/>

                            <!-- 끄면 자동 전송만 멈춘다. 위의 Synchronize는 그대로
                                 동작하고, 아래 두 줄도 그대로 보인다 — 밀린 수가
                                 늘어나는 것이 보여야 꺼 둔 사실을 잊지 않는다. -->
                            <CheckBox Content="Auto"
                                      IsChecked="{Binding IsAutoSyncOn}"
                                      IsEnabled="{Binding IsSyncIdle}"
                                      Margin="0,0,0,2"/>
                            <TextBlock Style="{StaticResource PanelHint}" Margin="0,0,0,8"
                                       Text="Sends every 30 minutes on its own. Turning it off does not stop the button above."/>

                            <TextBlock Text="{Binding SyncLastSuccessText}"
                                       Style="{StaticResource PanelHint}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SyncPendingText}"
                                       Style="{StaticResource PanelHint}" TextWrapping="Wrap"
                                       Margin="0,2,0,14"/>

                            <Button Content="Preview Sync Data"
                                    Style="{StaticResource SecondaryBtn}"
                                    Padding="16,0" HorizontalAlignment="Left"
                                    IsEnabled="{Binding IsSyncIdle}"
                                    Command="{Binding PreviewSyncDataCommand}"/>
                            <TextBlock Style="{StaticResource PanelHint}" Margin="0,6,0,0"
                                       Text="Writes exactly what would be sent to a file, so it can be read first. Nothing leaves this computer."/>

                            <TextBlock Text="{Binding SyncPreviewMessage}"
                                       Style="{StaticResource PanelHint}" TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ 아래: 복원 (위험) ═══ -->
            <Border Grid.Row="3" Margin="0,18,0,0"
                    Background="#FEF2F2"
                    BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="RESTORE" Style="{StaticResource EyebrowLabel}"
                               Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock Text="Roll back to a backup file" Style="{StaticResource PanelTitle}"/>
                    <TextBlock Style="{StaticResource PanelHint}" Margin="0,0,0,12"
                               Text="Replaces all current data with the contents of a backup (.db) file. Nothing is merged — the data in the app now is gone. The current state is backed up automatically first, and the app restarts when the restore finishes."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding BackupFilePath}"
                                 IsReadOnly="True"
                                 Style="{StaticResource FieldInput}"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Browse"
                                Style="{StaticResource SecondaryBtn}"
                                Padding="12,0" Margin="0,0,8,0"
                                Command="{Binding SelectBackupFileCommand}"/>
                        <Button Grid.Column="2" Content="🔄  Restore"
                                Style="{StaticResource DangerBtn}"
                                Padding="16,0"
                                Command="{Binding RestoreDbCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 뒤로 + 메시지 -->
            <StackPanel Grid.Row="4" Margin="0,18,0,0">
                <Button Content="← Back"
                        Style="{StaticResource SecondaryBtn}"
                        Padding="16,0"
                        HorizontalAlignment="Left"
                        Click="OnBackClick"
                        Margin="0,0,0,10"/>
                <TextBlock Text="{Binding Message}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" FontSize="13"
                           Margin="0,0,0,14"/>

                <!-- 이 줄이 이 화면을 Data Center로 묶은 이유의 절반이다. 데이터를
                     빼내는 길은 "지금 보고 있는 목록"과 "앱 데이터 전체" 둘인데,
                     그 갈림길에 답해 주는 곳이 어디에도 없었다. 그래서 백업을 찾던
                     사람이 판매 내역의 Export를 눌렀다. 화면별 Export를 여기로
                     옮기지 않는 것은, 그것들의 값어치가 걸러 놓은 목록 그대로를
                     내보내는 데 있어서 — 옮기면 그 화면들의 필터를 여기에 다시
                     만들어야 한다. -->
                <TextBlock Style="{StaticResource PanelHint}" TextWrapping="Wrap"
                           Text="Looking for a list you were just reading? Sales History, Stock History, Alerts and Reports each export what is on their screen, filters and all. This page is for the whole dataset."/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
