<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.BackupExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Lightweight_Digital_Inventory_Management___POS_System.Converters"
             mc:Ignorable="d"
             Background="White"
             d:DesignWidth="500" d:DesignHeight="700">

    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Width="420" Margin="0,24,0,24" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 제목 -->
            <TextBlock Grid.Row="0"
                       Text="Backup / Export"
                       Style="{StaticResource PageTitle}"
                       Margin="0,0,0,28"/>

            <!-- Import Products -->
            <StackPanel Grid.Row="1" Margin="0,0,0,24">
                <TextBlock Text="IMPORT PRODUCTS" Style="{StaticResource EyebrowLabel}"/>
                <TextBlock Text="CSV 또는 Excel 파일에서 제품을 가져옵니다."
                           FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding ImportFilePath}"
                             IsReadOnly="True"
                             Style="{StaticResource FieldInput}"
                             Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Browse"
                            Style="{StaticResource SecondaryBtn}"
                            Padding="12,0"
                            Command="{Binding SelectImportFileCommand}"/>
                </Grid>
                <Button Content="📥  Import Products"
                        Style="{StaticResource PrimaryBtn}"
                        Padding="16,0"
                        HorizontalAlignment="Left"
                        Command="{Binding ImportProductsCommand}"/>
            </StackPanel>

            <!-- DB Backup -->
            <StackPanel Grid.Row="2" Margin="0,0,0,24">
                <TextBlock Text="DATABASE BACKUP" Style="{StaticResource EyebrowLabel}"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding BackupLocation}"
                             IsReadOnly="True"
                             Style="{StaticResource FieldInput}"
                             Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Browse"
                            Style="{StaticResource SecondaryBtn}"
                            Padding="12,0"
                            Command="{Binding SelectBackupLocationCommand}"/>
                </Grid>
                <Button Content="💾  Create DB Backup"
                        Style="{StaticResource SecondaryBtn}"
                        Padding="16,0"
                        HorizontalAlignment="Left"
                        Command="{Binding CreateDbBackupCommand}"/>
            </StackPanel>

            <!-- Export Data -->
            <StackPanel Grid.Row="3" Margin="0,0,0,24">
                <TextBlock Text="EXPORT DATA" Style="{StaticResource EyebrowLabel}"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding AvailableExportTypes}"
                              SelectedItem="{Binding SelectedExportType}"
                              Height="36" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="CSV"   IsChecked="{Binding IsCsvFormat}"
                                     Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,0,16,0"/>
                        <RadioButton Content="Excel"
                                     IsChecked="{Binding IsCsvFormat, Converter={StaticResource InverseBoolConverter}}"
                                     Foreground="{StaticResource TextBrush}" FontSize="13"/>
                    </StackPanel>
                </Grid>
                <Button Content="📤  Export Data"
                        Style="{StaticResource SecondaryBtn}"
                        Padding="16,0"
                        HorizontalAlignment="Left"
                        Command="{Binding ExportDataCommand}"/>
            </StackPanel>

            <!-- Restore DB -->
            <StackPanel Grid.Row="4" Margin="0,0,0,24">
                <TextBlock Text="RESTORE DATABASE" Style="{StaticResource EyebrowLabel}"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding BackupFilePath}"
                             IsReadOnly="True"
                             Style="{StaticResource FieldInput}"
                             Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Browse"
                            Style="{StaticResource SecondaryBtn}"
                            Padding="12,0"
                            Command="{Binding SelectBackupFileCommand}"/>
                </Grid>
                <Button Content="🔄  Restore DB"
                        Style="{StaticResource DangerBtn}"
                        Padding="16,0"
                        HorizontalAlignment="Left"
                        Command="{Binding RestoreDbCommand}"/>
            </StackPanel>

            <!-- 뒤로 + 메시지 -->
            <StackPanel Grid.Row="5">
                <Button Content="← Back"
                        Style="{StaticResource SecondaryBtn}"
                        Padding="16,0"
                        HorizontalAlignment="Left"
                        Click="OnBackClick"
                        Margin="0,0,0,12"/>
                <TextBlock Text="{Binding Message}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" FontSize="13"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>