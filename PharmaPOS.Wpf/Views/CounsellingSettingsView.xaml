<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.CounsellingSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="White"
             d:DesignWidth="560" d:DesignHeight="720">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Width="460" Margin="0,24,0,24" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 제목 -->
                <RowDefinition Height="Auto"/>   <!-- 참조 데이터 상태 -->
                <RowDefinition Height="Auto"/>   <!-- 인쇄 설정 -->
                <RowDefinition Height="Auto"/>   <!-- 스튜어드십 지표 -->
                <RowDefinition Height="Auto"/>   <!-- 연구 제출 -->
                <RowDefinition Height="Auto"/>   <!-- 버튼 -->
                <RowDefinition Height="Auto"/>   <!-- 메시지 -->
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Antibiotic Counselling"
                           Style="{StaticResource PageTitle}" Margin="0,0,0,8"/>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="Counselling sheets support pharmacist advice on antibiotic use. They do not provide dosing or diagnosis."/>
            </StackPanel>

            <!-- 참조 데이터 상태. 시드가 없으면 기능이 조용히 아무것도 하지 않으므로
                 그 사실을 가장 먼저 보여준다. -->
            <StackPanel Grid.Row="1" Margin="0,0,0,24">
                <TextBlock Text="WHO AWaRe REFERENCE DATA" Style="{StaticResource EyebrowLabel}"/>
                <TextBlock Text="{Binding ReferenceDataStatus}"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,24">
                <TextBlock Text="PRINTING" Style="{StaticResource EyebrowLabel}"/>

                <TextBlock Text="When an antibiotic is sold" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding AvailablePrintModes}"
                          SelectedItem="{Binding PrintMode}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"
                           Text="A counselling notice is shown on screen for every antibiotic sale — this cannot be turned off. Always prints the sheet as well; Ask lets you decide each time."/>

                <TextBlock Text="Send the sheet to" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding AvailableOutputs}"
                          SelectedItem="{Binding Output}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Printer sends the sheet to the default printer. File saves it as a text file instead - useful for checking the sheet when no printer is attached."/>

                <StackPanel Visibility="{Binding IsFileOutput, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,0,14">
                    <TextBlock Text="Folder (leave empty for the default location)" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding FileOutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldInput}"/>
                        <Button Grid.Column="1" Content="Browse"
                                Style="{StaticResource SecondaryBtn}"
                                Padding="12,0" Margin="6,0,0,0"
                                Command="{Binding BrowseFolderCommand}"/>
                    </Grid>
                </StackPanel>

                <TextBlock Text="Sheet length" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding AvailableSheetFormats}"
                          SelectedItem="{Binding SheetFormat}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"
                           Text="Full is about 20 cm on 58 mm paper. Compact is about 10 cm and drops the signature and QR block."/>

                <TextBlock Text="Local language" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding AvailableLocales}"
                          SelectedItem="{Binding SelectedLocale}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"
                           Text="English is always printed. A local language is added only after its translation has been reviewed and approved."/>

                <TextBlock Text="More information address (optional)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding QrUrl, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldInput}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="Leave empty to omit the information block from the sheet."/>
            </StackPanel>

            <!-- 스튜어드십 지표 -->
            <StackPanel Grid.Row="3" Margin="0,0,0,24">
                <TextBlock Text="STEWARDSHIP FIGURES" Style="{StaticResource EyebrowLabel}"/>
                <TextBlock Text="{Binding MetricsSummary}"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ── 연구 제출 ────────────────────────────────────────────────
                 항생제 내보내기 파일은 AMR 연구에 제출되어 약국 밖으로 나간다.
                 그 파일에서 이 약국을 가리키는 값은 아래 코드 하나뿐이고,
                 코드와 약국의 대응표는 연구기관만 갖는다 — 파일만 봐서는
                 어느 약국인지 알 수 없다.

                 약국이 자기 코드를 여기서 볼 수 있어야 무엇이 나가는지 알 수 있다.
                 숨겨진 식별자가 파일에 박혀 있다는 걸 나중에 알게 되는 쪽이 훨씬 나쁘다. -->
            <StackPanel Grid.Row="4" Margin="0,0,0,24">
                <TextBlock Text="RESEARCH SUBMISSION" Style="{StaticResource EyebrowLabel}"/>

                <TextBlock Text="Research site code" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
                <TextBox Text="{Binding ResearchSiteCode, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldInput}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Enter the code you were given when this pharmacy was enrolled - for example KH-PP-014. Do not enter the pharmacy name here: the point of the code is that the file identifies the site without naming it."/>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="It is written only into the antibiotic export, never into the sales export. Sales figures are never included in the antibiotic file. Leave it empty until you are enrolled - the export still works, but the file cannot be attributed."/>
            </StackPanel>

            <Grid Grid.Row="5" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="← Back"
                        Style="{StaticResource SecondaryBtn}"
                        Padding="16,0" Margin="0,0,6,0"
                        Command="{Binding BackCommand}"/>
                <Button Grid.Column="1" Content="Save"
                        Style="{StaticResource PrimaryBtn}"
                        Padding="16,0" Margin="6,0,0,0"
                        Command="{Binding SaveCommand}"/>
            </Grid>

            <TextBlock Grid.Row="6"
                       Text="{Binding Message}"
                       Style="{StaticResource ErrorText}" MinHeight="18"/>
        </Grid>
    </ScrollViewer>
</UserControl>
