<Window x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:policy="clr-namespace:PharmaPOS.Application.PasswordPolicy;assembly=PharmaPOS.Application"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Reset Password"
        Background="White"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="380">

    <!-- 높이를 320으로 못박아 두었더니 비밀번호 규칙 안내문이 두 줄 들어가면서
         Cancel/Reset 버튼이 창 밖으로 밀려 아예 보이지 않았다. AddUserWindow와 같이
         내용에 맞춰 늘어나게 둔다. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TargetUsernameText" Grid.Row="0"
                   Style="{StaticResource SectionLabel}" Margin="0,0,0,18"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="New Password" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="NewPasswordInput"/>
            <TextBlock Text="{x:Static policy:PasswordPolicyValidator.RuleSummary}"
                       Style="{StaticResource Caption}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Confirm New Password" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="ConfirmNewPasswordInput"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,6,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel"
                    Style="{StaticResource SecondaryBtn}"
                    Margin="0,0,6,0" Click="OnCancelClick"/>
            <Button Grid.Column="1" Content="Reset"
                    Style="{StaticResource PrimaryBtn}"
                    Margin="6,0,0,0" Click="OnResetClick"/>
        </Grid>

        <TextBlock x:Name="MessageText" Grid.Row="4"
                   Style="{StaticResource ErrorText}" MinHeight="18"/>
    </Grid>
</Window>