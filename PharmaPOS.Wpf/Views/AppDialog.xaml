<Window x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterOwner"
        d:DesignHeight="240">

    <!-- 창 테두리를 없애고 직접 그린다. 시스템 MessageBox는 앱의 다른 화면과
         모양이 전혀 달라서, 팝업만 나오면 다른 프로그램처럼 보인다. -->
    <Border Background="White" CornerRadius="14" Margin="16"
            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.22" BlurRadius="24" ShadowDepth="6"/>
        </Border.Effect>

        <Grid Margin="26,22,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Grid.Row="0"
                       FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>

            <!-- 영수증이나 상세 내역처럼 긴 내용도 들어오므로 넘치면 스크롤한다. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          MaxHeight="380" Margin="0,0,0,22">
                <TextBlock x:Name="MessageText"
                           FontSize="13" LineHeight="20"
                           Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel"
                        Style="{StaticResource SecondaryBtn}"
                        MinWidth="96" Padding="16,0" Margin="0,0,8,0"
                        Visibility="Collapsed"
                        IsCancel="True"
                        Click="OnCancelClick"/>
                <Button x:Name="ConfirmButton" Content="OK"
                        Style="{StaticResource PrimaryBtn}"
                        MinWidth="96" Padding="16,0"
                        IsDefault="True"
                        Click="OnConfirmClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
