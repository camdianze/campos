<Window x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add User"
        Background="White"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="380">

    <!-- 스타일은 App.xaml 공통 테마에서 온다. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Add User"
                   Style="{StaticResource PageTitle}" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="UsernameInput" Style="{StaticResource FieldInput}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PasswordInput" Style="{StaticResource FieldPassword}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="Confirm Password" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="ConfirmPasswordInput" Style="{StaticResource FieldPassword}"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,20">
            <TextBlock Text="Role" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="RoleComboBox"/>
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel"
                    Style="{StaticResource SecondaryBtn}"
                    Click="OnCancelClick" Margin="0,0,6,0"/>
            <Button Grid.Column="1" Content="Create"
                    Style="{StaticResource PrimaryBtn}"
                    Click="OnCreateClick" Margin="6,0,0,0"/>
        </Grid>

        <TextBlock x:Name="MessageText" Grid.Row="6"
                   Style="{StaticResource ErrorText}" MinHeight="18"/>
    </Grid>
</Window>