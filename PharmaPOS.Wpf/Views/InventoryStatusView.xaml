<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.InventoryStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Lightweight_Digital_Inventory_Management___POS_System.Converters"
             mc:Ignorable="d"
             Background="White"
             d:DesignWidth="960" d:DesignHeight="600">

    <!--
        표 정렬에 대해. 손대기 전에 아래 세 가지를 알고 있어야 한다.

        1) TreeView는 기본적으로 자식 항목을 왼쪽으로 들여쓴다. 그러면 제품 행과 배치 행의
           고정 컬럼이 들여쓴 만큼 어긋나서, 컬럼 폭을 똑같이 맞춰도 줄이 맞지 않는다.
           그래서 RowBase에서 TreeViewItem 템플릿을 직접 짜 들여쓰기를 없애고, 펼침 화살표를
           행 안의 고정 24px 컬럼으로 넣었다. 제품 행이든 배치 행이든 같은 x좌표에서 시작한다.

        2) 세로 구분선은 각 셀의 왼쪽 테두리로 그린다. 그래서 위아래 여백(Padding)을
           행 템플릿이 아니라 셀 하나하나가 들고 있다. 행 템플릿에 Padding을 주면
           선이 행 높이를 다 채우지 못하고 위아래가 끊겨 점선처럼 보인다.

        3) 헤더 / 제품 행 / 배치 행의 ColumnDefinitions는 반드시 같아야 한다.
           하나를 바꾸면 나머지 둘도 같이 바꾼다.
           PRODUCT만 *이고 나머지는 고정폭이다. 즉 창을 넓히면 늘어나는 건 이름 컬럼뿐이고
           STOCK~STATUS는 오른쪽 끝에 붙어 있는다. 데이터 컬럼을 왼쪽으로 당기고 싶다면
           PRODUCT에 MaxWidth를 걸고 마지막 컬럼을 *로 바꾸면 된다.
    -->
    <UserControl.Resources>
        <converters:UnixToDateConverter x:Key="UnixToDateConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 패널 안의 날짜 칸. 옆에 놓인 TextBox(FieldInput)와 높이·배경을 맞춘다.
             안쪽 입력칸(DatePickerTextBox) 모양은 App.xaml의 암시적 스타일이 맞춘다 —
             컨트롤 템플릿 안에서 만들어지는 요소라 화면 단위 리소스로는 잡히지 않는다. -->
        <Style x:Key="PanelDatePicker" TargetType="DatePicker">
            <Setter Property="Background"                 Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Height"                     Value="40"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Padding"                    Value="0"/>
        </Style>

        <!-- 셀 공통: 왼쪽 세로 구분선 + 안쪽 여백 -->
        <Style x:Key="Cell" TargetType="Border">
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="Padding"         Value="12,10"/>
        </Style>

        <!-- 첫 컬럼은 왼쪽에 선을 긋지 않는다 (표 바깥 테두리와 겹친다) -->
        <Style x:Key="FirstCell" TargetType="Border" BasedOn="{StaticResource Cell}">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- 상태 배지. 심각한 순서대로 Expired > Low > Expiring.
             제품 행(접힌 상태)은 배치 상태의 합집합이라 안쪽 문제가 빠짐없이 보이고,
             펼치면 배치 행에서 어느 배치 때문인지 구분된다.
             한 배치가 Expired이면서 Expiring일 수는 없지만(정의상 배타적),
             제품 행은 배치가 여러 개라 셋이 동시에 뜰 수 있다. -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius"      Value="5"/>
            <Setter Property="Padding"           Value="8,2"/>
            <Setter Property="Margin"            Value="0,2,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="RowBase" TargetType="TreeViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Row"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                  Focusable="False" ClickMode="Press"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                              RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Width="24" Height="24">
                                                    <Path x:Name="Chevron"
                                                          Data="M0,0 L4,4 L0,8"
                                                          Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.6"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chevron" Property="Stroke"
                                                                Value="{StaticResource PrimaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <!-- Margin 없음: 위아래 여백은 셀이 들고 있어야 세로선이 안 끊긴다 -->
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"/>
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <!-- 배치가 없는 행은 화살표 자리를 비운다. Collapsed가 아니라 Hidden이어야
                                 24px 자리가 유지돼 컬럼이 계속 맞는다. -->
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <!-- SourceName="Row"가 없으면 자식 행에 마우스를 올려도 부모가 같이 밝아진다. -->
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{StaticResource PrimarySoftBrush}"/>
                            </Trigger>

                            <!-- 선택 표시. 마우스오버 트리거보다 뒤에 있어야 골라 둔 행이
                                 다른 행을 가리키는 동안에도 계속 눈에 남는다. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{StaticResource PrimarySelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BatchRow" TargetType="TreeViewItem" BasedOn="{StaticResource RowBase}">
            <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}"/>
        </Style>

        <!-- 박스/낱개 내역. 총 수량 아래 한 줄로 붙는다.
             별도의 하위 행으로 만들지 않은 이유는 이 화면 맨 위 주석의 3번 때문이다 —
             행 종류가 늘어나면 ColumnDefinitions를 하나 더 똑같이 맞춰야 하고, 그러면서
             배치가 없는 제품과 배치가 있는 제품의 줄맞춤이 어긋나기 쉽다.
             단위(개)를 붙이지 않는 것은 STOCK 컬럼의 다른 숫자와 같은 규칙이다. -->
        <Style x:Key="BoxBreakdownText" TargetType="TextBlock">
            <Setter Property="FontSize"            Value="11"/>
            <Setter Property="Foreground"          Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin"              Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <!-- 입고/조정 패널 자리. 둘 다 접혀 있으면 높이가 0이라 표가 그만큼 넓어진다. -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <TextBlock Grid.Row="0"
                   Text="Inventory Status"
                   Style="{StaticResource PageTitle}"
                   Margin="0,0,0,20"/>

        <!-- 필터 바 -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="13" Height="36"
                     Margin="0,0,8,0"/>

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding AvailableExpiryFilters}"
                      SelectedItem="{Binding SelectedExpiryFilter}"
                      Height="36" Margin="0,0,8,0"/>

            <CheckBox Grid.Column="2"
                      Content="Low Stock Only"
                      IsChecked="{Binding LowStockOnly}"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"/>

            <ComboBox Grid.Column="3"
                      ItemsSource="{Binding AvailableSortOptions}"
                      SelectedItem="{Binding SelectedSortOption}"
                      Height="36"/>
        </Grid>

        <!-- 컬럼 헤더. 좌측 24는 행 템플릿의 펼침 화살표 컬럼과 맞춘 것이다. -->
        <Border Grid.Row="2"
                Background="{StaticResource SubtleSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1,1,1,1"
                CornerRadius="8,8,0,0"
                Padding="24,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"   MinWidth="200"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource FirstCell}">
                    <TextBlock Text="PRODUCT" Style="{StaticResource EyebrowLabel}" Margin="0"/>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Cell}">
                    <TextBlock Text="STOCK" Style="{StaticResource EyebrowLabel}" Margin="0"
                               HorizontalAlignment="Right"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Cell}">
                    <TextBlock Text="PRICE" Style="{StaticResource EyebrowLabel}" Margin="0"
                               HorizontalAlignment="Right"/>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Cell}">
                    <TextBlock Text="EXPIRY" Style="{StaticResource EyebrowLabel}" Margin="0"/>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Cell}">
                    <TextBlock Text="STATUS" Style="{StaticResource EyebrowLabel}" Margin="0"/>
                </Border>
            </Grid>
        </Border>

        <!-- 목록 -->
        <TreeView Grid.Row="3"
                  ItemsSource="{Binding GroupedItems}"
                  ItemContainerStyle="{StaticResource RowBase}"
                  SelectedItemChanged="OnTreeSelectedItemChanged"
                  BorderThickness="1,0,1,1"
                  BorderBrush="{StaticResource BorderBrushSoft}"
                  Background="White"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Batches}"
                                          ItemContainerStyle="{StaticResource BatchRow}">

                    <!-- 제품 행 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"   MinWidth="200"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource FirstCell}">
                            <TextBlock Text="{Binding ProductName}"
                                       FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- 현재고 / 기준 재고. 박스 상품이면 아래에 박스·낱개 내역이 붙는다.
                             합계(TotalQuantity)는 박스 상품이든 아니든 언제나 낱개 기준이다. -->
                        <Border Grid.Column="1" Style="{StaticResource Cell}">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding TotalQuantity}"
                                               FontSize="14" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SafetyStockLevel, StringFormat=' / {0}'}"
                                               FontSize="13"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            Visibility="{Binding IsBoxedProduct, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding BoxQuantity, StringFormat='📦 {0}'}"
                                               Style="{StaticResource BoxBreakdownText}"/>
                                    <TextBlock Text="{Binding UnitQuantity, StringFormat='💊 {0}'}"
                                               Style="{StaticResource BoxBreakdownText}"
                                               Margin="8,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Cell}">
                            <TextBlock Text="{Binding SellingPrice, StringFormat='${0:F2}'}"
                                       FontSize="13" Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Border>

                        <!-- 배치 중 가장 빠른 만료일 -->
                        <Border Grid.Column="3" Style="{StaticResource Cell}">
                            <TextBlock Text="{Binding EarliestExpiryDate, Converter={StaticResource UnixToDateConverter}}"
                                       FontSize="13" Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- 배지가 셋 다 뜰 수 있어 WrapPanel로 둔다. 컬럼이 좁아지면 다음 줄로 내려간다. -->
                        <Border Grid.Column="4" Style="{StaticResource Cell}">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Badge}"
                                        Background="{StaticResource DangerBrush}"
                                        Visibility="{Binding HasExpired, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Expired" Style="{StaticResource BadgeText}" Foreground="White"/>
                                </Border>
                                <Border Style="{StaticResource Badge}" Background="#FEE2E2"
                                        Visibility="{Binding IsLowStock, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Low" Style="{StaticResource BadgeText}"
                                               Foreground="{StaticResource DangerBrush}"/>
                                </Border>
                                <Border Style="{StaticResource Badge}" Background="#FEF3C7"
                                        Visibility="{Binding HasExpiringSoon, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Expiring" Style="{StaticResource BadgeText}" Foreground="#92400E"/>
                                </Border>
                            </WrapPanel>
                        </Border>
                    </Grid>

                    <!-- 배치 행 -->
                    <HierarchicalDataTemplate.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"   MinWidth="200"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="190"/>
                                </Grid.ColumnDefinitions>

                                <!-- 들여쓰기는 첫 컬럼 안에서만 준다. 오른쪽 고정 컬럼은 그대로 줄이 맞는다. -->
                                <Border Grid.Column="0" Style="{StaticResource FirstCell}">
                                    <TextBlock Text="{Binding BatchNumber}"
                                               FontSize="13" Foreground="{StaticResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="20,0,0,0" VerticalAlignment="Center"/>
                                </Border>

                                <!-- 어느 배치가 몇 통 남았고 몇 알이 헐려 있는지는 여기서 갈린다.
                                     제품 행의 내역은 이걸 배치별로 합친 결과다. -->
                                <Border Grid.Column="1" Style="{StaticResource Cell}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentQuantity}"
                                                   FontSize="13" Foreground="{StaticResource TextBrush}"
                                                   HorizontalAlignment="Right"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    Visibility="{Binding IsBoxedProduct, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding BoxQuantity, StringFormat='📦 {0}'}"
                                                       Style="{StaticResource BoxBreakdownText}"/>
                                            <TextBlock Text="{Binding UnitQuantity, StringFormat='💊 {0}'}"
                                                       Style="{StaticResource BoxBreakdownText}"
                                                       Margin="8,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 판매가는 제품 단위 값이라 배치 행에서는 비워둔다 -->
                                <Border Grid.Column="2" Style="{StaticResource Cell}"/>

                                <Border Grid.Column="3" Style="{StaticResource Cell}">
                                    <TextBlock Text="{Binding ExpiryDate, Converter={StaticResource UnixToDateConverter}}"
                                               FontSize="13" Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- 어느 배치가 임박/만료인지 여기서 구분된다. 제품 행은 이걸 합친 결과다. -->
                                <Border Grid.Column="4" Style="{StaticResource Cell}">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource Badge}"
                                                Background="{StaticResource DangerBrush}"
                                                Visibility="{Binding IsExpired, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Expired" Style="{StaticResource BadgeText}" Foreground="White"/>
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="#FEE2E2"
                                                Visibility="{Binding IsLowStock, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Low" Style="{StaticResource BadgeText}"
                                                       Foreground="{StaticResource DangerBrush}"/>
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="#FEF3C7"
                                                Visibility="{Binding IsExpiringSoon, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Expiring" Style="{StaticResource BadgeText}" Foreground="#92400E"/>
                                        </Border>
                                    </WrapPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </HierarchicalDataTemplate.ItemTemplate>

                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- 조정 패널. Adjustment를 누르기 전에는 접혀 있다.
             Products 화면의 Stock-IN 패널과 같은 자리·같은 방식이다 — 목록에서 고른 것을
             그대로 두고 아래에서 고치므로, 화면을 옮겨 다시 찾을 일이 없다. -->
        <Border Grid.Row="4"
                Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="8"
                Padding="18,14" Margin="0,14,0,0"
                Visibility="{Binding IsAdjustmentPanelVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Adjustment"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AdjustmentTargetSummary}"
                               FontSize="13" Margin="12,0,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="System Quantity" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding SystemQuantity, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Style="{StaticResource FieldInput}"/>
                        <TextBlock Text="{Binding SystemQuantityBreakdown}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Margin="2,4,0,0"/>
                    </StackPanel>

                    <!-- 박스 칸은 박스/낱개를 나눠 파는 상품에만 나온다. 실사는 선반에서
                         "안 뜯은 통 몇 개, 헐어 놓은 알 몇 개"로 세지, 총 알 수를 암산하지 않는다. -->
                    <StackPanel Grid.Column="1" Margin="4,0,4,0"
                                Visibility="{Binding IsBoxedBatchSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Physical Count — Unopened Boxes" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding PhysicalBoxCount, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldInput}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="4,0,4,0">
                        <TextBlock Text="{Binding PhysicalUnitCountLabel}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding PhysicalUnitCount, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldInput}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="4,0,4,0">
                        <TextBlock Text="Adjustment Delta" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Delta, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Style="{StaticResource FieldInput}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="4,0,0,0">
                        <TextBlock Text="Reason" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding AdjustmentReason, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldInput}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Cancel"
                            Style="{StaticResource SecondaryBtn}"
                            MinWidth="96" Margin="0,0,8,0"
                            Command="{Binding CancelAdjustmentCommand}"/>
                    <Button Content="Save"
                            Style="{StaticResource PrimaryBtn}"
                            MinWidth="96"
                            Command="{Binding SaveAdjustmentCommand}"/>
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Text="{Binding AdjustmentMessage}"
                           Style="{StaticResource ErrorText}"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <!-- 입고 패널. 조정 패널과 같은 자리에 놓이며 둘 중 하나만 열린다. -->
        <Border Grid.Row="4"
                Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="8"
                Padding="18,14" Margin="0,14,0,0"
                Visibility="{Binding IsStockInPanelVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Stock-IN"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StockInTargetSummary}"
                               FontSize="13" Margin="12,0,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 고른 배치가 그대로 들어와 있다. 새 배치를 넣으려면 여기를 고쳐 쓴다. -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Batch Number" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding StockInBatchNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldInput}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                        <TextBlock Text="Expiry Date" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding StockInExpiryDate}"
                                    Style="{StaticResource PanelDatePicker}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="4,0,4,0">
                        <TextBlock Text="Stock-IN Date" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding StockInDate}"
                                    Style="{StaticResource PanelDatePicker}"/>
                    </StackPanel>

                    <!-- 박스 상품이면 라벨이 "Boxes"로 바뀌고 아래에 낱개 환산량이 붙는다. -->
                    <StackPanel Grid.Column="3" Margin="4,0,0,0">
                        <TextBlock Text="{Binding StockInQuantityLabel}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding StockInQuantity, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldInput}"/>
                        <TextBlock Text="{Binding StockInTotalPreview}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Margin="2,4,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Cancel"
                            Style="{StaticResource SecondaryBtn}"
                            MinWidth="96" Margin="0,0,8,0"
                            Command="{Binding CancelStockInCommand}"/>
                    <Button Content="Save"
                            Style="{StaticResource PrimaryBtn}"
                            MinWidth="96"
                            Command="{Binding SaveStockInCommand}"/>
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Text="{Binding StockInMessage}"
                           Style="{StaticResource ErrorText}"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <!-- 하단 버튼 -->
        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="← Back"
                    Style="{StaticResource SecondaryBtn}"
                    Click="OnBackClick" Margin="0,0,8,0"/>

            <!-- 왜 지울 수 없는지 버튼을 누르기 전에 알려 준다. -->
            <TextBlock Grid.Column="1"
                       Text="{Binding DeleteBatchHint}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Margin="4,0,12,0"/>

            <!-- 다 팔린 배치 정리. 재고가 남아 있으면 꺼져 있다. -->
            <Button Grid.Column="2" Content="Delete Batch"
                    Style="{StaticResource DangerBtn}"
                    IsEnabled="{Binding CanDeleteSelectedBatch}"
                    Command="{Binding DeleteBatchCommand}" Margin="0,0,8,0"/>

            <Button Grid.Column="3" Content="Stock-in"
                    Style="{StaticResource PrimaryBtn}"
                    Command="{Binding StockInCommand}" Margin="0,0,8,0"/>

            <Button Grid.Column="4" Content="Adjustment"
                    Style="{StaticResource PrimaryBtn}"
                    Command="{Binding AdjustmentCommand}"/>
        </Grid>

        <TextBlock Grid.Row="6"
                   Text="{Binding Message}"
                   Style="{StaticResource ErrorText}"
                   MinHeight="18" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
