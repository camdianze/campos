<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.AdjustmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="White"
             d:DesignWidth="500" d:DesignHeight="650">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Foreground" Value="#6C757D"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Background"             Value="#F3F3F3"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="Height"                 Value="36"/>
            <Setter Property="FontSize"               Value="13"/>
            <Setter Property="Padding"                Value="10,8"/>
            <Setter Property="Foreground"             Value="#212529"/>
            <Setter Property="CaretBrush"             Value="#212529"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#BF5B92E5"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="16,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#F0F0F0"/>
            <Setter Property="Foreground"      Value="#212529"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="16,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Width="420" Margin="0,24,0,24" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Inventory Adjustment"
                   FontSize="28" FontWeight="Light" Foreground="#212529"
                   Margin="0,0,0,24"/>

        <!-- 상품 검색 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Product Search (barcode or name, press Enter)"
                       Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnSearchBoxKeyDown"
                     Style="{StaticResource FieldInput}"
                     Margin="0,0,0,8"/>
            <ListBox ItemsSource="{Binding SearchResults}"
                     SelectedItem="{Binding SelectedProduct}"
                     DisplayMemberPath="ProductName"
                     MaxHeight="100"
                     BorderBrush="#E0E0E0"
                     BorderThickness="1"
                     Margin="0,0,0,12"/>
            <TextBlock Text="Batch Number" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Batches}"
                      SelectedItem="{Binding SelectedBatch}"
                      DisplayMemberPath="BatchNumber"
                      Height="36"/>
        </StackPanel>

        <!-- 조정 정보 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="System Quantity" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding SystemQuantity, Mode=OneWay}"
                     IsReadOnly="True"
                     Style="{StaticResource FieldInput}"
                     Foreground="#6C757D"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Physical Count" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding PhysicalCount, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldInput}"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Adjustment Delta" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Delta, Mode=OneWay}"
                     IsReadOnly="True"
                     Style="{StaticResource FieldInput}"
                     Foreground="#6C757D"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Reason" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldInput}"/>
        </StackPanel>

        <!-- 버튼 -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="← Back"
                    Style="{StaticResource SecondaryBtn}"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,6,0"/>
            <Button Grid.Column="1" Content="Save"
                    Style="{StaticResource PrimaryBtn}"
                    Command="{Binding SaveCommand}"
                    Margin="6,0,0,0"/>
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="{Binding Message}"
                   Foreground="#E53E3E"
                   TextWrapping="Wrap" FontSize="13"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>