<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.AdjustmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="White"
             d:DesignWidth="500" d:DesignHeight="650">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Width="420" Margin="0,24,0,24" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Inventory Adjustment"
                   Style="{StaticResource PageTitle}"
                   Margin="0,0,0,24"/>

        <!-- 상품 검색 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">

            <!-- 고른 상품을 맨 위에 띄운다. 재고 화면에서 상품을 누르고 넘어오면
                 검색칸을 다시 볼 일 없이 무엇을 조정하는 중인지 바로 보인다. -->
            <Border Background="{StaticResource PrimarySoftBrush}"
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                    Visibility="{Binding HasSelectedProduct, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedProductName}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedProductDetail}"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Product Search (barcode or name, press Enter)"
                       Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnSearchBoxKeyDown"
                     Style="{StaticResource FieldInput}"
                     Margin="0,0,0,8"/>
            <ListBox ItemsSource="{Binding SearchResults}"
                     SelectedItem="{Binding SelectedProduct}"
                     DisplayMemberPath="ProductName"
                     MaxHeight="100"
                     BorderBrush="{StaticResource BorderBrushSoft}"
                     BorderThickness="1"
                     Margin="0,0,0,12"/>
            <TextBlock Text="Batch Number" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Batches}"
                      SelectedItem="{Binding SelectedBatch}"
                      DisplayMemberPath="BatchNumber"
                      Height="36"/>
        </StackPanel>

        <!-- 조정 정보 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="System Quantity" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding SystemQuantity, Mode=OneWay}"
                     IsReadOnly="True"
                     Style="{StaticResource FieldInput}"
                     Foreground="{StaticResource MutedTextBrush}"
                     Margin="0,0,0,4"/>
            <TextBlock Text="{Binding SystemQuantityBreakdown}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11" TextWrapping="Wrap"
                       Margin="2,0,0,14"/>

            <!-- 박스 실사 칸은 박스/낱개를 나눠 파는 상품에만 나온다.
                 실사는 선반에서 "안 뜯은 통 몇 개, 헐어 놓은 알 몇 개"로 세지,
                 총 알 수를 암산해서 세지 않는다. -->
            <StackPanel Visibility="{Binding IsBoxedProductSelected, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Physical Count — Unopened Boxes" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding PhysicalBoxCount, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldInput}"
                         Margin="0,0,0,4"/>
                <TextBlock Text="{Binding UnitsPerBox, StringFormat='{}{0} units per box.'}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11" TextWrapping="Wrap"
                           Margin="2,0,0,14"/>
            </StackPanel>

            <!-- 낱개 단위 상품은 이 칸 하나만 보이고, 라벨도 종전과 같은 "Physical Count"다. -->
            <TextBlock Text="{Binding PhysicalUnitCountLabel}" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding PhysicalUnitCount, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldInput}"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Adjustment Delta" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Delta, Mode=OneWay}"
                     IsReadOnly="True"
                     Style="{StaticResource FieldInput}"
                     Foreground="{StaticResource MutedTextBrush}"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Reason" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldInput}"/>
        </StackPanel>

        <!-- 버튼 -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="← Back"
                    Style="{StaticResource SecondaryBtn}"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,6,0"/>
            <Button Grid.Column="1" Content="Save"
                    Style="{StaticResource PrimaryBtn}"
                    Command="{Binding SaveCommand}"
                    Margin="6,0,0,0"/>
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="{Binding Message}"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" FontSize="13"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>