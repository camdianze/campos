<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.ProductListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svc="clr-namespace:Lightweight_Digital_Inventory_Management___POS_System.Services"
             mc:Ignorable="d"
             Background="White"
             d:DesignWidth="800" d:DesignHeight="550">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 숫자 칸은 오른쪽으로 붙인다. 왼쪽 정렬이면 10.4 / 27.61 / 6.78의 자릿수가
             어긋나 눈으로 크기를 견줄 수가 없다. 머리글도 같이 오른쪽으로 보내야 줄이 맞는다. -->
        <Style x:Key="NumericCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="NumericHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- 안쪽 입력칸(DatePickerTextBox) 모양은 App.xaml의 암시적 스타일이 맞춘다.
             컨트롤 템플릿 안에서 만들어지는 요소라, 화면 단위 리소스로는 잡히지 않는다. -->
        <Style x:Key="StockInDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="#F3F3F3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Products"
                   Style="{StaticResource PageTitle}"
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="13" Height="36"
                     Margin="0,0,8,0"/>

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding AvailableStatusFilters}"
                      SelectedItem="{Binding SelectedStatusFilter}"
                      Height="36"/>
        </Grid>

        <DataGrid Grid.Row="2"
                  x:Name="ProductsGrid"
                  PreviewMouseRightButtonDown="OnGridRightButtonDown"
                  ContextMenuOpening="OnGridContextMenuOpening"
                  ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  BorderThickness="1"
                  BorderBrush="{StaticResource BorderBrushSoft}"
                  RowBackground="White"
                  AlternatingRowBackground="{StaticResource SubtleSurfaceBrush}"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{StaticResource BorderBrushSoft}"
                  VerticalGridLinesBrush="{StaticResource BorderBrushSoft}"
                  RowHeight="36">

            <!-- 우클릭 메뉴. 재고·알림 화면과 같은 방식이다 — 빈 곳에서는 뜨지 않고,
                 우클릭한 줄이 곧바로 선택된다(WPF는 우클릭으로 선택을 옮기지 않는다). -->
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="View Details"
                              Command="{Binding ViewDetailCommand}"
                              IsEnabled="{Binding HasSelection}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <!-- Status 컬럼을 없앤 대신 비활성 상품은 행을 흐리게 둔다. 목록은 거의 전부
                 Active라 컬럼 하나가 같은 단어를 반복하고 있었다. 규칙이 아니라 예외가 보여야 한다.
                 Opacity를 함께 낮추는 이유: 상품명 앞의 AWaRe 색점은 글자색을 따르지 않는다. -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Product.Status}" Value="Inactive">
                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                            <Setter Property="Opacity"    Value="0.5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <!-- 성분명 앞의 점은 WHO AWaRe 분류다.
                     초록 ACCESS · 노랑 WATCH · 빨강 RESERVE · 검정 NOT RECOMMENDED.
                     항생제가 아니거나 참조 목록에 없으면 점이 없다.

                     점이 성분명 쪽에 붙는 이유: 분류를 정하는 값이 상품명이 아니라 성분명이다.
                     맨 앞 고정폭 칸에 두면 상품마다 점의 위치가 제각각이 되지 않아
                     세로로 훑어 내려갈 수 있다. -->
                <DataGridTemplateColumn Header="Generic" Width="170" SortMemberPath="Product.GenericName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 점이 없는 상품도 칸은 그대로 비워 둔다(Collapsed가 아니라 Hidden이
                                     아니어도 되는 이유: 칸 너비가 고정이라 이름 시작점이 안 밀린다). -->
                                <Ellipse Grid.Column="0"
                                         Width="9" Height="9"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Fill="{Binding DotBrush}"
                                         ToolTip="{Binding AwareTooltip}"
                                         Visibility="{Binding HasAwareGroup, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Product.GenericName}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 머리글은 짧게 줄였다. 이 이름들은 화면에만 쓰는 것이라
                     가져오기·내보내기 파일의 컬럼명(product_name, cost_price …)과는 무관하다. -->
                <DataGridTextColumn Header="Product Name"     Binding="{Binding Product.ProductName}"     Width="*"/>
                <!-- Strength · Form · Unit 셋은 서로 다른 값이다.
                     "500 mg" / "Syrup" / "Bottle"처럼 나란히 놓여야 구분이 된다. -->
                <DataGridTextColumn Header="Strength"         Binding="{Binding Product.Strength}"        Width="80"/>
                <DataGridTextColumn Header="Form"             Binding="{Binding Product.DosageForm}"      Width="90"/>
                <DataGridTextColumn Header="Unit"             Binding="{Binding Product.Unit}"            Width="70"/>
                <DataGridTextColumn Header="Barcode"          Binding="{Binding Product.Barcode}"         Width="118"/>
                <DataGridTextColumn Header="Internal"         Binding="{Binding Product.InternalBarcode}" Width="115"/>

                <!-- 가격은 소수점 두 자리로 고정한다. 10.4와 27.61이 섞이면 자리가 어긋난다. -->
                <DataGridTextColumn Header="Cost"    Binding="{Binding Product.CostPrice, StringFormat={}{0:N2}}"
                                    Width="78"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericHeader}"/>
                <DataGridTextColumn Header="Selling" Binding="{Binding Product.SellingPrice, StringFormat={}{0:N2}}"
                                    Width="82"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericHeader}"/>
                <DataGridTextColumn Header="Safety"  Binding="{Binding Product.SafetyStockLevel}"
                                    Width="68"
                                    ElementStyle="{StaticResource NumericCell}"
                                    HeaderStyle="{StaticResource NumericHeader}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 입고 패널. 상품을 고르기 전에는 접혀 있다. -->
        <Border Grid.Row="3"
                Background="#F8F9FA" CornerRadius="8"
                Padding="18,14" Margin="0,14,0,0"
                Visibility="{Binding IsStockInPanelVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Stock-IN"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedProduct.ProductName}"
                               FontSize="13" Margin="12,0,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Batch Number" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#F3F3F3" BorderThickness="0"
                                 Height="36" Padding="10,0" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                        <TextBlock Text="Expiry Date" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding ExpiryDate}"
                                    Style="{StaticResource StockInDatePicker}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="4,0,4,0">
                        <TextBlock Text="Stock-IN Date" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding StockInDate}"
                                    Style="{StaticResource StockInDatePicker}"/>
                    </StackPanel>

                    <!-- 박스 상품이면 라벨이 "Boxes"로 바뀌고, 아래에 낱개 환산량이 붙는다.
                         입고는 늘 박스째 들어오므로 낱개 총량을 암산해서 적게 하지 않는다.
                         낱개 단위 상품이면 미리보기가 빈 문자열이라 줄이 생기지 않는다. -->
                    <StackPanel Grid.Column="3" Margin="8,0,0,0">
                        <TextBlock Text="{Binding StockInQuantityLabel}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding StockInQuantity, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#F3F3F3" BorderThickness="0"
                                 Height="36" Padding="10,0" VerticalContentAlignment="Center"/>
                        <TextBlock Text="{Binding StockInTotalPreview}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Margin="2,4,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="{svc:Loc ui.common.cancel, Cancel}"
                            Background="#F0F0F0" Foreground="{StaticResource TextBrush}"
                            BorderThickness="0" Height="36" MinWidth="96" Cursor="Hand"
                            Margin="0,0,8,0"
                            Command="{Binding CancelStockInCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="{svc:Loc ui.common.save, Save}"
                            Background="#BF5B92E5" Foreground="White" FontWeight="SemiBold"
                            BorderThickness="0" Height="36" MinWidth="96" Cursor="Hand"
                            Command="{Binding SaveStockInCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Text="{Binding StockInMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" FontSize="13"
                           Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="{svc:Loc ui.common.back, ← Back}"
                    Style="{StaticResource SecondaryBtn}"
                    Padding="16,0" Click="OnBackClick" Margin="0,0,8,0"/>

            <Button Grid.Column="2" Content="{svc:Loc ui.products.add, Add Product}"
                    Style="{StaticResource PrimaryBtn}"
                    Padding="16,0" Command="{Binding AddProductCommand}" Margin="0,0,8,0"/>

            <Button Grid.Column="3" Content="{svc:Loc ui.common.edit, Edit}"
                    Style="{StaticResource SecondaryBtn}"
                    Padding="16,0" Command="{Binding EditCommand}" Margin="0,0,8,0"/>

            <Button Grid.Column="4" Content="{svc:Loc ui.common.deactivate, Deactivate}"
                    Style="{StaticResource DangerBtn}"
                    Padding="16,0" Command="{Binding DeactivateCommand}" Margin="0,0,8,0"/>

            <Button Grid.Column="5" Content="{svc:Loc ui.products.print_barcode, Print Barcode}"
                    Style="{StaticResource SecondaryBtn}"
                    Padding="16,0" Command="{Binding PrintInternalBarcodeCommand}"/>
        </Grid>

        <TextBlock Grid.Row="5"
                   Text="{Binding Message}"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" FontSize="13"
                   Margin="0,8,0,0"/>
    </Grid>
</UserControl>