<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.ProductListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="White"
             d:DesignWidth="800" d:DesignHeight="550">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- DatePicker에 Height만 주면 안쪽 입력칸은 기본 여백을 그대로 써서
             옆 TextBox보다 글자가 위로 붙고 상자도 얕아 보인다.
             안쪽 DatePickerTextBox까지 같이 맞춰야 높이가 나란해진다. -->
        <Style x:Key="StockInDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="#F3F3F3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Resources">
                <Setter.Value>
                    <ResourceDictionary>
                        <Style TargetType="DatePickerTextBox">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DatePickerTextBox">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ResourceDictionary>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Products"
                   Style="{StaticResource PageTitle}"
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="13" Height="36"
                     Margin="0,0,8,0"/>

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding AvailableStatusFilters}"
                      SelectedItem="{Binding SelectedStatusFilter}"
                      Height="36"/>
        </Grid>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  BorderThickness="1"
                  BorderBrush="{StaticResource BorderBrushSoft}"
                  RowBackground="White"
                  AlternatingRowBackground="{StaticResource SubtleSurfaceBrush}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource BorderBrushSoft}"
                  RowHeight="36">
            <DataGrid.Columns>
                <!-- 상품명 뒤의 점은 WHO AWaRe 분류다.
                     초록 ACCESS · 노랑 WATCH · 빨강 RESERVE · 검정 NOT RECOMMENDED.
                     항생제가 아니거나 참조 목록에 없으면 점이 없다. -->
                <DataGridTemplateColumn Header="Product Name" Width="*" SortMemberPath="Product.ProductName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Product.ProductName}" VerticalAlignment="Center"/>
                                <Ellipse Width="9" Height="9" Margin="7,0,0,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding DotBrush}"
                                         ToolTip="{Binding AwareTooltip}"
                                         Visibility="{Binding HasAwareGroup, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Generic Name"     Binding="{Binding Product.GenericName}"     Width="*"/>
                <DataGridTextColumn Header="Unit"             Binding="{Binding Product.Unit}"            Width="90"/>
                <DataGridTextColumn Header="Barcode"          Binding="{Binding Product.Barcode}"         Width="120"/>
                <DataGridTextColumn Header="Internal Barcode" Binding="{Binding Product.InternalBarcode}" Width="120"/>
                <DataGridTextColumn Header="Cost Price"       Binding="{Binding Product.CostPrice}"       Width="90"/>
                <DataGridTextColumn Header="Selling Price"    Binding="{Binding Product.SellingPrice}"    Width="90"/>
                <DataGridTextColumn Header="Safety Stock"     Binding="{Binding Product.SafetyStockLevel}" Width="90"/>
                <DataGridTextColumn Header="Status"           Binding="{Binding Product.Status}"          Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 입고 패널. 상품을 고르기 전에는 접혀 있다. -->
        <Border Grid.Row="3"
                Background="#F8F9FA" CornerRadius="8"
                Padding="18,14" Margin="0,14,0,0"
                Visibility="{Binding IsStockInPanelVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Stock-IN"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedProduct.ProductName}"
                               FontSize="13" Margin="12,0,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Batch Number" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#F3F3F3" BorderThickness="0"
                                 Height="36" Padding="10,0" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                        <TextBlock Text="Expiry Date" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding ExpiryDate}"
                                    Style="{StaticResource StockInDatePicker}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="4,0,4,0">
                        <TextBlock Text="Stock-IN Date" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding StockInDate}"
                                    Style="{StaticResource StockInDatePicker}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="8,0,0,0">
                        <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding StockInQuantity, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#F3F3F3" BorderThickness="0"
                                 Height="36" Padding="10,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Cancel"
                            Background="#F0F0F0" Foreground="{StaticResource TextBrush}"
                            BorderThickness="0" Height="36" MinWidth="96" Cursor="Hand"
                            Margin="0,0,8,0"
                            Command="{Binding CancelStockInCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="Save"
                            Background="#BF5B92E5" Foreground="White" FontWeight="SemiBold"
                            BorderThickness="0" Height="36" MinWidth="96" Cursor="Hand"
                            Command="{Binding SaveStockInCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Text="{Binding StockInMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" FontSize="13"
                           Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="← Back"
                    Style="{StaticResource SecondaryBtn}"
                    Padding="16,0" Click="OnBackClick" Margin="0,0,8,0"/>

            <Button Grid.Column="2" Content="Add Product"
                    Style="{StaticResource PrimaryBtn}"
                    Padding="16,0" Command="{Binding AddProductCommand}" Margin="0,0,8,0"/>

            <Button Grid.Column="3" Content="Edit"
                    Style="{StaticResource SecondaryBtn}"
                    Padding="16,0" Command="{Binding EditCommand}" Margin="0,0,8,0"/>

            <Button Grid.Column="4" Content="Deactivate"
                    Style="{StaticResource DangerBtn}"
                    Padding="16,0" Command="{Binding DeactivateCommand}" Margin="0,0,8,0"/>

            <Button Grid.Column="5" Content="Print Barcode"
                    Style="{StaticResource SecondaryBtn}"
                    Padding="16,0" Command="{Binding PrintInternalBarcodeCommand}"/>
        </Grid>

        <TextBlock Grid.Row="5"
                   Text="{Binding Message}"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" FontSize="13"
                   Margin="0,8,0,0"/>
    </Grid>
</UserControl>