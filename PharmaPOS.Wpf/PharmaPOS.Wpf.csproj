<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- 게시 결과물이 PharmaPOS.exe가 되도록 고정한다.
         RootNamespace는 기존 C#/XAML 네임스페이스와 맞추기 위해 그대로 둔다. -->
    <AssemblyName>PharmaPOS</AssemblyName>
    <RootNamespace>Lightweight_Digital_Inventory_Management___POS_System</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- AWaRe 참조 데이터와 복약안내 로케일 파일.
         소스에 박아넣지 않고 파일로 두는 이유는 분류 개정이나 번역 교체를
         재빌드 없이 처리하기 위해서다. 단일 파일 게시에서도 exe 옆에 그대로 복사된다. -->
    <!-- README는 내부 문서라 고객에게 나가는 게시본에는 넣지 않는다.
         파일 형식·알려진 한계 같은 개발 메모가 들어 있다. -->
    <Content Include="seeds\**\*" Exclude="seeds\**\*.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="locales\**\*" Exclude="locales\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 로그인 전 화면의 CAMDIANS 워드마크에 쓰는 글꼴(Abril Fatface).
         윈도우 기본 글꼴이 아니라, 어셈블리에 넣어야 고객 PC에서도 같은 모양으로 나온다.
         Resource라서 단일 파일 게시에서도 exe 안에 함께 들어가고 곁딸린 파일이 생기지 않는다.
         SIL Open Font License 1.1 — 함께 배포하려면 OFL.txt를 같이 두어야 한다. -->
    <Resource Include="Fonts\AbrilFatface-Regular.ttf" />
    <!-- 크메르어 화면·인쇄용. 윈도우에 크메르 폰트가 없는 PC가 흔하고, 없으면
         글자가 네모로 나온다. 있는지 없는지에 기대지 않도록 함께 싣는다. -->
    <Resource Include="Fonts\NotoSansKhmer-Regular.ttf" />
    <Resource Include="Fonts\NotoSansKhmer-Bold.ttf" />
    <Content Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PharmaPOS.Application\PharmaPOS.Application.csproj" />
    <ProjectReference Include="..\PharmaPOS.DataAccess\PharmaPOS.DataAccess.csproj" />
    <ProjectReference Include="..\PharmaPOS.Domain\PharmaPOS.Domain.csproj" />
  </ItemGroup>

</Project>
