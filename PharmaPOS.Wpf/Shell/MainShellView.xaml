<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Shell.MainShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:PharmaPOS.Application;assembly=PharmaPOS.Application"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="White"
             d:DesignWidth="1440" d:DesignHeight="1024">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 셸 전용 버튼 두 종류. 크기와 배치가 이 화면에만 있는 형태라 여기 남기고,
             색은 App.xaml 팔레트를 참조한다. -->
        <Style x:Key="TopBtn" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="{StaticResource FieldHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderBrushSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TopBtn의 파랑 변형. BasedOn으로 Background만 바꾸면 hover 때 템플릿이
             회색을 다시 칠해버려서 템플릿째 따로 둔다. BottomCardBtnPrimary도 같은 이유다. -->
        <Style x:Key="TopBtnPrimary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BottomCardBtn" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="{StaticResource PrimarySoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BottomCardBtnPrimary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 바 -->
        <Grid Grid.Row="0" Margin="50,0,50,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="0,0,40,0">
                <TextBlock Text="{Binding WelcomeMessage}"
                           Style="{StaticResource PageTitle}"/>

                <TextBlock Text="{x:Static app:AppVersion.Display}"
                           Style="{StaticResource Caption}"
                           FontSize="11"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Content="My Page"
                    Style="{StaticResource TopBtnPrimary}"
                    Command="{Binding MyPageCommand}"
                    Width="80" Margin="0,0,8,0"/>

            <Button Grid.Column="2" Content="Logout"
                    Style="{StaticResource TopBtn}"
                    Command="{Binding LogoutCommand}"
                    Foreground="{StaticResource DangerBrush}"
                    Width="60"/>

            <!-- Alerts 버튼 + 팝업 -->
            <Grid Grid.Column="4" VerticalAlignment="Center">

                <!-- 🔔 버튼 -->
                <Button x:Name="AlertsButton"
                    Width="60" Height="25"
                    BorderThickness="0"
                    Background="{StaticResource FieldBrush}"
                    Cursor="Hand"
                    Click="OnAlertsButtonClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <Grid>
                                    <TextBlock Text="🔔" FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                    <!-- 알림 숫자 배지 -->
                                    <Border x:Name="Badge"
        Background="{StaticResource DangerBrush}"
        CornerRadius="8"
        MinWidth="16" Height="16"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="0,-4,-4,0"
        Padding="3,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AlertCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding AlertCount}"
               FontSize="10" Foreground="White"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 알림 팝업 -->
                <Popup x:Name="AlertsPopup"
                   PlacementTarget="{Binding ElementName=AlertsButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                    <Border Background="White"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Width="320"
                        Padding="0,0,0,8">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.15"
                                          BlurRadius="16" ShadowDepth="4"/>
                        </Border.Effect>
                        <StackPanel>

                            <!-- 팝업 헤더 -->
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12,12,0,0" Padding="16,12">
                                <Grid>
                                    <TextBlock Text="🔔  Alerts"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>
                                    <Border Background="{StaticResource DangerBrush}" CornerRadius="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Padding="8,2">
                                        <TextBlock Text="{Binding AlertCount}"
                                               FontSize="11" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 알림 목록 -->
                            <ItemsControl ItemsSource="{Binding RecentAlerts}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,10" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 우선순위 색상 바 -->
                                                <Border Grid.Column="0"
                                                    Width="4" CornerRadius="2"
                                                    Margin="0,0,10,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F59E0B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Priority}" Value="Critical">
                                                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                                    <Setter Property="Background" Value="#38A169"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding ProductName}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding AlertType}"
                                                               FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                                        <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                                        <TextBlock Text="{Binding Priority}"
                                                               FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 빈 상태 -->
                            <TextBlock Text="No alerts 🎉"
                                   FontSize="13" Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AlertCount}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- View All 버튼 -->
                            <Button Content="View All Alerts →"
                                Style="{StaticResource PrimaryBtn}"
                                Margin="16,4,16,0"
                                Click="OnAlertsClick"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <!-- 구분선 -->
        <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrushSoft}"
                HorizontalAlignment="Left" Width="500" Margin="40,0,0,0"/>

        <!-- 메인 3카드 -->
        <Grid Grid.Row="2" Margin="50,24,50,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Stock-IN -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="20" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="8" ShadowDepth="1"/>
                </Border.Effect>
                <!-- 입고가 Products 화면 안으로 들어가면서, 예전 Stock-IN 카드 자리를
                     Products가 대신한다. 진입점이 둘로 갈리지 않게 하기 위해서다. -->
                <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnProductsClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!-- Background이 없으면 Grid는 클릭을 받지 않는다. 그래서 예전에는
                                 글자와 아이콘 위에서만 눌렸다. Transparent를 주면 카드 전체가
                                 하나의 버튼이 된다(보이는 색은 바깥 Border가 그린다). -->
                            <Grid Background="Transparent">
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="32,28,0,0">
                                    <TextBlock Text="Products" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                                <!-- 아이콘은 로그인 전 화면의 파란 면과 같은 색으로 맞춘다.
                                     WPF는 컬러 이모지를 글자색 한 톤으로 그린다. -->
                                <TextBlock Text="💊" FontSize="120"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,60,0,0"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>

            <!-- Inventory -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="20" Margin="5,0,5,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="8" ShadowDepth="1"/>
                </Border.Effect>
                <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnInventoryClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!-- Background이 없으면 Grid는 클릭을 받지 않는다. 그래서 예전에는
                                 글자와 아이콘 위에서만 눌렸다. Transparent를 주면 카드 전체가
                                 하나의 버튼이 된다(보이는 색은 바깥 Border가 그린다). -->
                            <Grid Background="Transparent">
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="32,28,0,0">
                                    <TextBlock Text="Inventory" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                                <!-- 아이콘은 로그인 전 화면의 파란 면과 같은 색으로 맞춘다.
                                     WPF는 컬러 이모지를 글자색 한 톤으로 그린다. -->
                                <TextBlock Text="📦" FontSize="120"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,60,0,0"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>

            <!-- POS Sale -->
            <!-- 세 카드를 완전히 같게 둔다. 하나만 색이 다르면 한 벌로 읽히지 않는다. -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                    CornerRadius="20" Margin="10,0,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="8" ShadowDepth="1"/>
                </Border.Effect>
                <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnPosSaleClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!-- Background이 없으면 Grid는 클릭을 받지 않는다. 그래서 예전에는
                                 글자와 아이콘 위에서만 눌렸다. Transparent를 주면 카드 전체가
                                 하나의 버튼이 된다(보이는 색은 바깥 Border가 그린다). -->
                            <Grid Background="Transparent">
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="32,28,0,0">
                                    <TextBlock Text="POS Sale" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                                <!-- 아이콘은 로그인 전 화면의 파란 면과 같은 색으로 맞춘다.
                                     WPF는 컬러 이모지를 글자색 한 톤으로 그린다. -->
                                <TextBlock Text="🛒" FontSize="120"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,60,0,0"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>

        <!-- 하단 버튼 (관리자: 4개). Recovery Settings는 My Page 안으로 옮겼다. -->
        <UniformGrid Grid.Row="3" Rows="1" Margin="50,0,50,24"
                     Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVis}}">
            <Button Content="⚙️  Admin Dashboard" Style="{StaticResource BottomCardBtnPrimary}" Click="OnAdminDashboardClick" Margin="0,0,6,0"/>
            <Button Content="📈  Reports"         Style="{StaticResource BottomCardBtn}" Click="OnReportsClick"        Margin="3,0"/>
            <Button Content="📊  History"         Style="{StaticResource BottomCardBtn}" Click="OnHistoryClick"        Margin="3,0"/>
            <Button Content="🧫  Counselling"     Style="{StaticResource BottomCardBtn}" Click="OnCounsellingSettingsClick" Margin="6,0,0,0"/>
        </UniformGrid>

        <!-- 하단 버튼 (직원).
             조정 버튼은 뺐다 — 재고 화면에서 배치를 고르고 그 아래 패널에서 하는 쪽으로 옮겼다.
             리포트는 관리자 줄과 같은 자리에 두되 잠가 둔다. 아예 감추면 관리자 화면과
             자리가 어긋나 보이고, 열어 주면 직원이 매출을 보게 된다. -->
        <UniformGrid Grid.Row="3" Rows="1" Columns="2" Margin="50,0,50,24">
            <UniformGrid.Style>
                <Style TargetType="UniformGrid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </UniformGrid.Style>
            <!-- 잠긴 버튼. 기본 ToolTip은 비활성 컨트롤에서 안 뜨므로 ShowOnDisabled를 켠다. -->
            <Button Content="🔒  Reports"    Style="{StaticResource BottomCardBtn}"
                    IsEnabled="False"
                    ToolTip="Administrators only."
                    ToolTipService.ShowOnDisabled="True"
                    Margin="0,0,6,0"/>
            <Button Content="📊  History"    Style="{StaticResource BottomCardBtn}" Click="OnHistoryClick"    Margin="6,0,0,0"/>
        </UniformGrid>

    </Grid>
</UserControl>