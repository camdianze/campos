<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Shell.MainShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="White"
             d:DesignWidth="1440" d:DesignHeight="1024">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 셸 전용 버튼 두 종류. 크기와 배치가 이 화면에만 있는 형태라 여기 남기고,
             색은 App.xaml 팔레트를 참조한다. -->
        <Style x:Key="TopBtn" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="{StaticResource FieldHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderBrushSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BottomCardBtn" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="{StaticResource PrimarySoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 바 -->
        <Grid Grid.Row="0" Margin="50,0,50,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding WelcomeMessage}"
                       Style="{StaticResource PageTitle}"
                       VerticalAlignment="Center"
                       Margin="0,0,40,0"/>

            <Button Grid.Column="1" Content="Change ID/PW"
                    Style="{StaticResource TopBtn}"
                    Command="{Binding ChangePasswordCommand}"
                    Width="100" Margin="0,0,8,0"/>

            <Button Grid.Column="2" Content="Logout"
                    Style="{StaticResource TopBtn}"
                    Command="{Binding LogoutCommand}"
                    Foreground="{StaticResource DangerBrush}"
                    Width="60"/>

            <!-- Alerts 버튼 + 팝업 -->
            <Grid Grid.Column="4" VerticalAlignment="Center">

                <!-- 🔔 버튼 -->
                <Button x:Name="AlertsButton"
                    Width="60" Height="25"
                    BorderThickness="0"
                    Background="{StaticResource FieldBrush}"
                    Cursor="Hand"
                    Click="OnAlertsButtonClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <Grid>
                                    <TextBlock Text="🔔" FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                    <!-- 알림 숫자 배지 -->
                                    <Border x:Name="Badge"
        Background="{StaticResource DangerBrush}"
        CornerRadius="8"
        MinWidth="16" Height="16"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="0,-4,-4,0"
        Padding="3,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AlertCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding AlertCount}"
               FontSize="10" Foreground="White"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 알림 팝업 -->
                <Popup x:Name="AlertsPopup"
                   PlacementTarget="{Binding ElementName=AlertsButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                    <Border Background="White"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Width="320"
                        Padding="0,0,0,8">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.15"
                                          BlurRadius="16" ShadowDepth="4"/>
                        </Border.Effect>
                        <StackPanel>

                            <!-- 팝업 헤더 -->
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12,12,0,0" Padding="16,12">
                                <Grid>
                                    <TextBlock Text="🔔  Alerts"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>
                                    <Border Background="{StaticResource DangerBrush}" CornerRadius="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Padding="8,2">
                                        <TextBlock Text="{Binding AlertCount}"
                                               FontSize="11" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 알림 목록 -->
                            <ItemsControl ItemsSource="{Binding RecentAlerts}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,10" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 우선순위 색상 바 -->
                                                <Border Grid.Column="0"
                                                    Width="4" CornerRadius="2"
                                                    Margin="0,0,10,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F59E0B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Priority}" Value="Critical">
                                                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                                    <Setter Property="Background" Value="#38A169"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding ProductName}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding AlertType}"
                                                               FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                                        <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                                        <TextBlock Text="{Binding Priority}"
                                                               FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 빈 상태 -->
                            <TextBlock Text="No alerts 🎉"
                                   FontSize="13" Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AlertCount}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- View All 버튼 -->
                            <Button Content="View All Alerts →"
                                Style="{StaticResource PrimaryBtn}"
                                Margin="16,4,16,0"
                                Click="OnAlertsClick"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <!-- 구분선 -->
        <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrushSoft}"
                HorizontalAlignment="Left" Width="500" Margin="40,0,0,0"/>

        <!-- 메인 3카드 -->
        <Grid Grid.Row="2" Margin="50,24,50,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Stock-IN -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="20" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="8" ShadowDepth="1"/>
                </Border.Effect>
                <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnStockInClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="32,28,0,0">
                                    <TextBlock Text="Stock-IN" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                                <TextBlock Text="📥" FontSize="120"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,60,0,0"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>

            <!-- Inventory -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="20" Margin="5,0,5,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="8" ShadowDepth="1"/>
                </Border.Effect>
                <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnInventoryClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="32,28,0,0">
                                    <TextBlock Text="Inventory" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                                <TextBlock Text="📦" FontSize="120"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,60,0,0"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>

            <!-- POS Sale -->
            <!-- POS Sale은 주 동선이라 옅은 파랑으로 남겨 다른 두 카드와 구분한다. -->
            <Border Grid.Column="2" Background="{StaticResource PrimarySoftBrush}"
                    BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"
                    CornerRadius="20" Margin="10,0,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="8" ShadowDepth="1"/>
                </Border.Effect>
                <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnPosSaleClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="32,28,0,0">
                                    <TextBlock Text="POS Sale" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                                <TextBlock Text="🛒" FontSize="120"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,60,0,0"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>

        <!-- 하단 버튼 (관리자: 5개) -->
        <UniformGrid Grid.Row="3" Rows="1" Margin="50,0,50,24"
                     Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVis}}">
            <Button Content="⚙️  Admin Dashboard"   Style="{StaticResource BottomCardBtn}" Click="OnAdminDashboardClick"  Margin="0,0,6,0"/>
            <Button Content="🔐  Recovery Settings" Style="{StaticResource BottomCardBtn}" Click="OnRecoverySettingsClick" Margin="3,0"/>
            <Button Content="💊  Products"          Style="{StaticResource BottomCardBtn}" Click="OnProductsClick"         Margin="3,0"/>
            <Button Content="✏️  Adjustment"        Style="{StaticResource BottomCardBtn}" Click="OnAdjustmentClick"       Margin="3,0"/>
            <Button Content="📊  History"     Style="{StaticResource BottomCardBtn}" Click="OnHistoryClick"     Margin="6,0,0,0"/>
        </UniformGrid>

        <!-- 하단 버튼 (직원: 4개) -->
        <UniformGrid Grid.Row="3" Rows="1" Margin="50,0,50,24">
            <UniformGrid.Style>
                <Style TargetType="UniformGrid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </UniformGrid.Style>
            <Button Content="🔐  Recovery Settings" Style="{StaticResource BottomCardBtn}" Click="OnRecoverySettingsClick" Margin="0,0,6,0"/>
            <Button Content="💊  Products"          Style="{StaticResource BottomCardBtn}" Click="OnProductsClick"         Margin="3,0"/>
            <Button Content="✏️  Adjustment"        Style="{StaticResource BottomCardBtn}" Click="OnAdjustmentClick"       Margin="3,0"/>
            <Button Content="📊  History"     Style="{StaticResource BottomCardBtn}" Click="OnHistoryClick"     Margin="6,0,0,0"/>
        </UniformGrid>

    </Grid>
</UserControl>