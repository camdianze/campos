<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <!-- 바탕화면 바로 아래에 쏟으면 개인 파일과 섞여 무엇이 게시본인지 알 수 없다.
         전용 폴더에 모아 그 폴더째 전달한다. -->
    <PublishDir>C:\Users\이선유\Desktop\PharmaPOS</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- 디버그 심볼(.pdb)은 고객에게 줄 이유가 없다. 내부 구조가 그대로 드러난다. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 네이티브 라이브러리(e_sqlite3 등)까지 exe 안에 넣어 곁딸린 파일을 줄인다. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
</Project>