<UserControl x:Class="CamPOS.Wpf.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="White"
             d:DesignWidth="800" d:DesignHeight="450">

    <UserControl.Resources>
        <!-- 이 화면에만 있는 선택 카드. 색은 App.xaml 팔레트를 참조한다.
             높이를 고정해 둔다 — 화면 높이를 다 먹으면 카드 두 장이 빈 여백만
             거대하게 두르고, 정작 읽을 글자는 구석에 남는다. -->
        <Style x:Key="HistoryCardBtn" TargetType="Button">
            <Setter Property="Background"          Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"         Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness"     Value="1.5"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment"   Value="Top"/>
            <Setter Property="Height"              Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,32,40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <TextBlock Grid.Row="0"
                   Text="History"
                   Style="{StaticResource PageTitle}"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="Select a history type to view records."
                   Style="{StaticResource Caption}" FontSize="14"
                   Margin="0,0,0,24"/>

        <!-- 카드 3개. 세 번째(Analysis)는 관리자 전용이다 — 갈라지기 전 Reports 화면이
             그랬고, 화면을 나누는 작업이 매출을 직원에게 여는 결정까지 곁다리로
             해 버릴 일은 아니다. -->
        <Grid Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sale History -->
            <Button Grid.Column="0" Style="{StaticResource HistoryCardBtn}"
                    Margin="0,0,12,0" Width="310" Click="OnSaleHistoryClick">
                <Grid>
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left"
                                Margin="30,26,0,0">
                        <TextBlock Text="Sale History"
                                   FontSize="26" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="View all sales transactions"
                                   Style="{StaticResource Caption}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                    <TextBlock Text="🛒" FontSize="76"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,40,0,0"/>
                </Grid>
            </Button>

            <!-- Stock History -->
            <Button Grid.Column="1" Style="{StaticResource HistoryCardBtn}"
                    Margin="6,0,6,0" Width="310" Click="OnStockHistoryClick">
                <Grid>
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left"
                                Margin="30,26,0,0">
                        <TextBlock Text="Stock History"
                                   FontSize="26" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Stock in and adjustments, in one timeline"
                                   Style="{StaticResource Caption}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                    <TextBlock Text="📦" FontSize="76"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,40,0,0"/>
                </Grid>
            </Button>

            <!-- Analysis (매출 분석). 관리자만.
                 기본 ToolTip은 비활성 컨트롤에서 안 뜨므로 ShowOnDisabled를 켠다. -->
            <Button Grid.Column="2" Style="{StaticResource HistoryCardBtn}"
                    Margin="12,0,0,0" Width="310" Click="OnAnalysisClick"
                    IsEnabled="{Binding IsAdministrator, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    ToolTip="Administrators only."
                    ToolTipService.ShowOnDisabled="True">
                <Grid>
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left"
                                Margin="30,26,0,0">
                        <TextBlock Text="Analysis"
                                   FontSize="26" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Sales totals, product ranking and trends"
                                   Style="{StaticResource Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                    <TextBlock FontSize="76"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,40,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="📈"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdministrator, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                        <Setter Property="Text" Value="🔒"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Button>
        </Grid>

        <!-- 뒤로 버튼 -->
        <Button Grid.Row="3"
                Content="← Back"
                Style="{StaticResource SecondaryBtn}"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="0,24,0,0"
                Click="OnBackClick"/>
    </Grid>
</UserControl>
