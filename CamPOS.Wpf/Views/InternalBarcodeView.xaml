<UserControl x:Class="Lightweight_Digital_Inventory_Management___POS_System.Views.InternalBarcodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="420" d:DesignHeight="420">

    <Grid Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Internal Barcode" Style="{StaticResource PageTitle}" Margin="0,0,0,18"/>

        <TextBlock Grid.Row="1" Text="{Binding ProductName}"
                   Style="{StaticResource SectionLabel}" Margin="0,0,0,14"/>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Internal Barcode" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding InternalBarcode, Mode=OneWay}" IsReadOnly="True"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Label Quantity" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding LabelQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>

            <!-- 프린터는 고르지 않는다. 영수증·복약안내와 같이 기본 프린터로 나간다. -->
            <TextBlock Text="{Binding LabelPlanHint}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11" TextWrapping="Wrap"/>
            <TextBlock Text="Labels go to the default printer."
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="← Back" Style="{StaticResource SecondaryBtn}" Margin="0,0,5,0" Command="{Binding BackCommand}"/>
            <Button Grid.Column="1" Content="Generate" Style="{StaticResource SecondaryBtn}" Margin="5,0,5,0" Command="{Binding GenerateBarcodeCommand}"/>
            <Button Grid.Column="2" Content="Print Label" Style="{StaticResource PrimaryBtn}" Margin="5,0,0,0" Command="{Binding PrintLabelCommand}"/>
        </Grid>

        <TextBlock Grid.Row="5" Text="{Binding Message}" Style="{StaticResource ErrorText}" MinHeight="18" Margin="0,10,0,0"/>
    </Grid>
</UserControl>