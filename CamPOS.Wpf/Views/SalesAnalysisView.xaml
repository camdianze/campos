<UserControl x:Class="CamPOS.Wpf.Views.SalesAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:CamPOS.Wpf.Converters"
             mc:Ignorable="d"
             Background="{StaticResource PageBackgroundBrush}"
             d:DesignWidth="1366" d:DesignHeight="768">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:ChangeDirectionToBrushConverter x:Key="ChangeBrush"/>

        <Style x:Key="ChangeCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- 요약 카드. 관리자 대시보드의 지표 카드와 같은 모양을 쓴다. -->
        <Style x:Key="SummaryCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin"  Value="0,0,10,0"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="SummaryLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin"   Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="SummaryChange" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin"     Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 제목 -->
            <RowDefinition Height="Auto"/>   <!-- 기간 선택 -->
            <RowDefinition Height="Auto"/>   <!-- 비교 기준 -->
            <RowDefinition Height="Auto"/>   <!-- 요약 카드 -->
            <RowDefinition Height="*"/>      <!-- 상품 순위 -->
            <RowDefinition Height="Auto"/>   <!-- 추이 / 달력 -->
            <RowDefinition Height="Auto"/>   <!-- 하단 버튼 -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sales Analysis"
                   Style="{StaticResource PageTitle}" Margin="0,0,0,14"/>

        <!-- 기간 선택 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DatePicker Grid.Column="0" SelectedDate="{Binding DateFrom}" Height="36" Margin="0,0,6,0"/>
            <DatePicker Grid.Column="1" SelectedDate="{Binding DateTo}"   Height="36" Margin="0,0,6,0"/>

            <Button Grid.Column="2" Content="Apply" Style="{StaticResource PrimaryBtn}"
                    Padding="16,0" Margin="0,0,6,0" Command="{Binding RefreshCommand}"/>
            <Button Grid.Column="3" Content="This Month" Style="{StaticResource SecondaryBtn}"
                    Padding="14,0" Margin="0,0,6,0" Command="{Binding ThisMonthCommand}"/>
            <Button Grid.Column="4" Content="Last Month" Style="{StaticResource SecondaryBtn}"
                    Padding="14,0" Command="{Binding LastMonthCommand}"/>
        </Grid>

        <!-- 무엇을 무엇과 비교한 값인지. 이게 없으면 증감 숫자를 신뢰할 수 없다. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="{Binding PeriodLabel}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ComparisonLabel}" FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 요약 카드 3개.
             넷이던 자리다 — 복약안내 출력률은 항생제 리포트로 갔다. 그 값은 항생제 판매를
             분모로 쓰므로 매출 카드 옆에 있으면 분모가 둘인 줄을 나란히 읽게 된다. -->
        <UniformGrid Grid.Row="3" Columns="3" Margin="0,0,0,16">
            <Border Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="Sales Amount" Style="{StaticResource SummaryLabel}"/>
                    <TextBlock Text="{Binding Report.Current.Amount, StringFormat={}{0:N2}}" Style="{StaticResource SummaryValue}"/>
                    <!-- 리엘 환산. 환율 표기를 반드시 함께 낸다 — 판매 시점의 환율은
                         저장되지 않아 지난달 매출도 오늘 환율로 환산되기 때문이다.
                         환율이 오르면 과거 매출이 저절로 올라가 보이는데, 어느 환율로
                         계산한 값인지 적혀 있어야 참고값으로 읽힌다. -->
                    <TextBlock Text="{Binding SalesAmountInRiel}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Text="{Binding ExchangeRateNote}"
                               Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                    <!-- 화살표만 방향색을 입히고 "vs 이전값"은 흐린 글씨로 둔다.
                         줄 전체가 붉으면 비교 대상 숫자까지 경고처럼 읽힌다. -->
                    <TextBlock Style="{StaticResource SummaryChange}">
                        <Run Text="{Binding Report.AmountChange, Mode=OneWay}"
                             Foreground="{Binding Report.AmountDirection, Converter={StaticResource ChangeBrush}}"
                             FontWeight="SemiBold"/>
                        <Run Text="{Binding Report.AmountDelta, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SummaryCard}">
                <StackPanel>
                    <TextBlock Text="Transactions" Style="{StaticResource SummaryLabel}"/>
                    <TextBlock Text="{Binding Report.Current.TransactionCount}" Style="{StaticResource SummaryValue}"/>
                    <TextBlock Style="{StaticResource SummaryChange}">
                        <Run Text="{Binding Report.TransactionChange, Mode=OneWay}"
                             Foreground="{Binding Report.TransactionDirection, Converter={StaticResource ChangeBrush}}"
                             FontWeight="SemiBold"/>
                        <Run Text="{Binding Report.TransactionDelta, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SummaryCard}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Units Sold" Style="{StaticResource SummaryLabel}"/>
                    <TextBlock Text="{Binding Report.Current.ItemCount}" Style="{StaticResource SummaryValue}"/>
                    <TextBlock Style="{StaticResource SummaryChange}">
                        <Run Text="{Binding Report.ItemChange, Mode=OneWay}"
                             Foreground="{Binding Report.ItemDirection, Converter={StaticResource ChangeBrush}}"
                             FontWeight="SemiBold"/>
                        <Run Text="{Binding Report.ItemDelta, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ── 상품별 순위 ──────────────────────────────────────────────────
             항생제 표가 오른쪽에 있던 동안은 절반 폭이었다. 이제 한 화면을 쓰므로
             성분명과 용량까지 칸을 내줄 수 있다. -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 정렬 기준을 바꿔도 다시 조회하지 않는다 (집계값은 같다). -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="105"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Product Ranking"
                           Style="{StaticResource SectionTitle}" Margin="0"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="Sort by" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="3" Height="30"
                          ItemsSource="{Binding AvailableSorts}"
                          SelectedItem="{Binding SelectedSort}"/>
            </Grid>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Products}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      BorderThickness="1"
                      BorderBrush="{StaticResource BorderBrushSoft}"
                      RowBackground="White"
                      AlternatingRowBackground="{StaticResource SubtleSurfaceBrush}"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BorderBrushSoft}"
                      RowHeight="32">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#"       Binding="{Binding Rank}"        Width="36"/>
                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Generic" Binding="{Binding GenericName}" Width="180"/>
                    <DataGridTextColumn Header="Strength" Binding="{Binding Strength}"   Width="80"/>
                    <DataGridTextColumn Header="Qty"     Binding="{Binding Quantity}"    Width="60"/>
                    <DataGridTextColumn Header="Amount"  Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="90"/>
                    <!-- 순위표에서는 전기 대비 증감보다 "이 약이 매출의 얼마를 차지하는가"가
                         읽을 값이다. 순위 자체가 이미 크기순이므로, 1위가 전체의 40%인지
                         4%인지가 그다음 질문이 된다. 증감은 위쪽 요약 카드가 맡는다.
                         분모는 이 표에 실린 줄들의 합이라 비중을 다 더하면 100%다. -->
                    <DataGridTextColumn Header="Share"   Binding="{Binding AmountShare}" Width="70"
                                        ElementStyle="{StaticResource ChangeCell}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ── 아래: 12개월 추이 / 달력 ─────────────────────────────────────
             한 자리를 둘이 나눠 쓴다. 같은 주제(약국 전체의 시간별 매출)를 다른 배율로
             본 것이라, 따로 놓기보다 바꿔 보는 편이 맞다.

             추이는 고른 기간이 아니라 그 기간이 끝나는 달까지의 12개월이다. 한 달치 표만
             봐서는 그 달이 평소보다 많은지 적은지 알 수 없어서 둔 것이다.

             차트 패키지를 쓰지 않는다. 이 저장소는 바코드도 사각형으로 직접 그리고 있고,
             막대 12개에 패키지 의존성을 더할 이유가 없다. -->
        <Border Grid.Row="5" Style="{StaticResource Card}" Padding="18,14" Margin="0,14,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsTrendVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Sales, Last 12 Months"
                                   Style="{StaticResource SectionTitle}" Margin="0"/>
                        <!-- 고른 기간과 다른 구간이라는 사실을 적어 둔다. 이게 없으면
                             위 카드의 금액과 그래프의 합이 왜 다른지 알 수 없다. -->
                        <TextBlock Text="{Binding TrendPeriodLabel}"
                                   Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsCalendarVisible, Converter={StaticResource BoolToVis}}">
                        <Button Content="◀" Style="{StaticResource SecondaryBtn}"
                                Padding="8,0" MinWidth="0" Height="26" FontSize="11"
                                Command="{Binding PreviousMonthCommand}"/>
                        <TextBlock Text="{Binding CalendarMonthLabel}"
                                   Style="{StaticResource SectionTitle}" Margin="8,0"
                                   MinWidth="120" TextAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <!-- 아직 오지 않은 달로는 넘어가지 않는다 (CanGoToNextMonth). -->
                        <Button Content="▶" Style="{StaticResource SecondaryBtn}"
                                Padding="8,0" MinWidth="0" Height="26" FontSize="11"
                                Command="{Binding NextMonthCommand}"/>
                        <!-- 칸을 다 더한 값. 세로로 훑지 않아도 그 달이 얼마였는지 알 수 있다. -->
                        <TextBlock Text="{Binding CalendarTotalLabel}"
                                   Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock Text="{Binding CalendarTotalInRiel}"
                                   Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="12 months" Height="26" Padding="10,0" FontSize="11"
                                Command="{Binding ShowTrendCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTrendVisible}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Calendar" Height="26" Padding="10,0" FontSize="11" Margin="6,0,0,0"
                                Command="{Binding ShowCalendarCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCalendarVisible}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ── 달력 ──────────────────────────────────────────────────
                     날짜를 누르면 팝업이 아니라 기간 자체가 그 하루로 바뀐다.
                     그러면 위 카드와 상품 순위가 전부 그 날 기준이 되어 팝업 하나보다
                     보이는 것이 많고, 줄 단위 내역은 판매 이력 화면이 이미 맡고 있어
                     여기서 되풀이할 필요가 없다. -->
                <StackPanel Visibility="{Binding IsCalendarVisible, Converter={StaticResource BoolToVis}}">
                    <UniformGrid Columns="7" Margin="0,0,0,4">
                        <TextBlock Text="Mon" Style="{StaticResource Caption}" TextAlignment="Center"/>
                        <TextBlock Text="Tue" Style="{StaticResource Caption}" TextAlignment="Center"/>
                        <TextBlock Text="Wed" Style="{StaticResource Caption}" TextAlignment="Center"/>
                        <TextBlock Text="Thu" Style="{StaticResource Caption}" TextAlignment="Center"/>
                        <TextBlock Text="Fri" Style="{StaticResource Caption}" TextAlignment="Center"/>
                        <TextBlock Text="Sat" Style="{StaticResource Caption}" TextAlignment="Center"/>
                        <TextBlock Text="Sun" Style="{StaticResource Caption}" TextAlignment="Center"/>
                    </UniformGrid>

                    <ItemsControl ItemsSource="{Binding CalendarCells}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 빈 자리는 테두리도 그리지 않는다. 달이 시작하기 전의
                                     칸에 테두리가 있으면 판매가 0인 날처럼 읽힌다. -->
                                <Button Height="46" Margin="1"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        ToolTip="{Binding Tooltip}"
                                        Command="{Binding DataContext.SelectDayCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Padding" Value="5,3"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                Padding="{TemplateBinding Padding}"
                                                                CornerRadius="5">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSunday}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}"/>
                                                </DataTrigger>
                                                <!-- 오늘은 테두리로만 표시한다. 칠해 버리면
                                                     매출이 많은 날처럼 보인다. -->
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFiller}" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>

                                    <Grid>
                                        <TextBlock Text="{Binding DayLabel}" FontSize="10"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <!-- 금액은 반올림해서 넣는다. 칸이 좁아 소수점까지
                                             넣으면 줄이 넘친다. 정확한 값은 툴팁과,
                                             그 날을 눌렀을 때의 요약 카드에 있다. -->
                                        <TextBlock Text="{Binding AmountLabel}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── 12개월 막대 ────────────────────────────────────────── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsTrendVisible}" Value="True"/>
                                        <Condition Binding="{Binding HasSalesTrendData}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 세로축. 가장 큰 달이 얼마였는지 적어야 막대 높이를 숫자로 읽을 수 있다.
                         행 높이 18/132/20은 막대 쪽과 같은 값이어야 기준선이 맞는다. -->
                    <Grid Grid.Column="0" MinWidth="40" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="132"/>
                            <RowDefinition Height="20"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="1" Text="{Binding SalesTrendMaxDisplay}"
                                   FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="1" Text="0"
                                   FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding SalesTrendBars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Background를 투명으로 두는 이유: 색 없는 칸에는 마우스가
                                     닿지 않아 툴팁이 뜨지 않는다. -->
                                <Grid Margin="3,0" Background="Transparent" ToolTip="{Binding Tooltip}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="18"/>
                                        <RowDefinition Height="132"/>
                                        <RowDefinition Height="20"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding AmountDisplay}"
                                               FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Bottom"/>

                                    <Border Grid.Row="1" VerticalAlignment="Bottom"
                                            Height="{Binding Height}"
                                            Background="{StaticResource PrimaryBrush}"/>

                                    <TextBlock Grid.Row="2" Text="{Binding Label}"
                                               FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <TextBlock Text="No sales in the last 12 months."
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsTrendVisible}" Value="True"/>
                                        <Condition Binding="{Binding HasSalesTrendData}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 하단: 뒤로 + 내보내기 + 메시지 -->
        <Grid Grid.Row="6" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="← Back"
                    Style="{StaticResource SecondaryBtn}"
                    Padding="16,0" Command="{Binding BackCommand}"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding Message}"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" FontSize="13"
                       VerticalAlignment="Center" Margin="12,0,12,0"/>

            <Button Grid.Column="2" Content="Export CSV"
                    Style="{StaticResource SecondaryBtn}"
                    Padding="16,0" Command="{Binding ExportCommand}"/>
        </Grid>
    </Grid>
</UserControl>
