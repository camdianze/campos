<Window x:Class="CamPOS.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CamPOS.Wpf"
        mc:Ignorable="d"
        Title="CamdiansRX"
        WindowState="Maximized"
        FontFamily="Segoe UI, pack://application:,,,/Fonts/#Siemreap"
        Background="{StaticResource PageBackgroundBrush}"
        Height="800" Width="1280">
    <!-- FontFamily는 폴백 목록이다. 라틴 글자는 앞의 Segoe UI가 그리고, 그 폰트에
         없는 크메르 글자만 함께 싣는 Siemreap으로 떨어진다. 버튼마다 크메르
         폰트를 직접 지정하면 영어일 때도 그 폰트로 그려져 글씨체가 달라진다.

         Background를 여기 두는 이유: Background를 지정하지 않은 UserControl은
         아무것도 칠하지 않아 창의 배경이 그대로 비친다. 화면 여덟 개가 그 상태였고,
         창의 기본값이 흰색이라 바탕색을 바꿔도 그 화면들만 희게 남았다. 창에 한 번
         칠해 두면 그 화면들이 저절로 따라오고, 앞으로 만드는 화면도 마찬가지다 —
         화면마다 Background를 적는 쪽은 빠뜨린 것이 화면을 열기 전에는 보이지 않는다. -->
    <Grid>
        <!-- 시작 화면은 App.xaml.cs의 OnStartup에서 동적으로 채워진다. -->
    </Grid>
</Window>