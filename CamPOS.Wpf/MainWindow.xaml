<Window x:Class="CamPOS.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CamPOS.Wpf"
        mc:Ignorable="d"
        Title="CamdiansRX"
        WindowState="Maximized"
        FontFamily="pack://application:,,,/Fonts/#Inter, Segoe UI, pack://application:,,,/Fonts/#Siemreap"
        Background="{StaticResource PageBackgroundBrush}"
        Height="800" Width="1280">
    <!-- FontFamily는 폴백 목록이고, 앞에서부터 그 글자를 가진 글꼴이 그린다.

         Inter가 라틴 글자를 맡는다. 주소를 적어 싣는 글꼴을 가리킨다 — 이름만
         'Inter'라고 적으면 WPF는 PC에 설치된 글꼴에서만 찾고, 약국 PC에는 없으므로
         조용히 Segoe UI로 떨어진다. 오류가 안 나서 알아채기 어렵다.

         뒤의 둘은 Inter에 없는 글자를 받는다. Segoe UI가 ✕(U+2715)와 ＋(U+FF0B)를,
         Siemreap이 크메르 글자와 리엘 기호 ៛(U+17DB)를 그린다 — 셋 다 Inter에 없고,
         ៛는 화면의 금액 옆에 늘 붙는 글자다.

         버튼마다 크메르 폰트를 직접 지정하면 영어일 때도 그 폰트로 그려져
         글씨체가 달라진다.

         Background를 여기 두는 이유: Background를 지정하지 않은 UserControl은
         아무것도 칠하지 않아 창의 배경이 그대로 비친다. 화면 여덟 개가 그 상태였고,
         창의 기본값이 흰색이라 바탕색을 바꿔도 그 화면들만 희게 남았다. 창에 한 번
         칠해 두면 그 화면들이 저절로 따라오고, 앞으로 만드는 화면도 마찬가지다 —
         화면마다 Background를 적는 쪽은 빠뜨린 것이 화면을 열기 전에는 보이지 않는다. -->
    <Grid>
        <!-- 시작 화면은 App.xaml.cs의 OnStartup에서 동적으로 채워진다. -->
    </Grid>
</Window>